{% doc %}
  Renders breadcrumbs with BreadcrumbList structured data on product and collection pages.
  Shown when the breadcrumbs theme setting is on.

  @example
  {% render 'breadcrumbs' %}
{% enddoc %}

{%- if settings.show_breadcrumbs -%}
  {%- liquid
    assign home_url = request.origin | append: routes.root_url
    assign crumb_collection = collection
    if request.page_type == 'product' and crumb_collection == blank
      assign crumb_collection = product.collections.first
    endif
  -%}
  <nav class="breadcrumbs page-width" aria-label="{{ 'general.breadcrumbs.label' | t }}">
    <ol>
      <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
      {%- if crumb_collection != blank -%}
        <li>
          {%- if request.page_type == 'collection' -%}
            <span aria-current="page">{{ crumb_collection.title | escape }}</span>
          {%- else -%}
            <a href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a>
          {%- endif -%}
        </li>
      {%- endif -%}
      {%- if request.page_type == 'product' -%}
        <li><span aria-current="page">{{ product.title | escape }}</span></li>
      {%- endif -%}
    </ol>
  </nav>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ 'general.breadcrumbs.home' | t | json }}, "item": {{ home_url | json }} }
        {%- if crumb_collection != blank -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ crumb_collection.title | json }}, "item": {{ request.origin | append: crumb_collection.url | json }} }
        {%- endif -%}
        {%- if request.page_type == 'product' -%}
          {%- if crumb_collection != blank -%}{%- assign product_position = 3 -%}{%- else -%}{%- assign product_position = 2 -%}{%- endif -%}
          ,{ "@type": "ListItem", "position": {{ product_position }}, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
