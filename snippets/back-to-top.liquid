{% doc %}
  Renders a round back to top button whose ring fills as the shopper scrolls down the page.

  @example
  {% render 'back-to-top' %}
{% enddoc %}

<back-to-top class="back-to-top">
  <button type="button" class="back-to-top__button" aria-label="{{ 'general.accessibility.back_to_top' | t }}">
    <svg class="back-to-top__ring" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      <circle class="back-to-top__track" cx="24" cy="24" r="21"></circle>
      <circle class="back-to-top__fill" cx="24" cy="24" r="21" pathLength="100"></circle>
    </svg>
    <svg class="back-to-top__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 19V5M6 11l6-6 6 6"/>
    </svg>
  </button>
</back-to-top>
