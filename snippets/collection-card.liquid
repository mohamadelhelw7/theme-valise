{% doc %}
  Renders a collection tile with image, title, product count and arrow.

  @param {collection} [collection] - The collection to link to
  @param {string} [title] - Title override
  @param {image} [image] - Image override
  @param {string} [color] - Background color behind the image
  @param {string} [attributes] - Extra attributes for the root element, such as block.shopify_attributes

  @example
  {% render 'collection-card', collection: collection, color: '#DCE1D2' %}
{% enddoc %}

{%- liquid
  assign card_title = title | default: collection.title | default: 'Collection'
  assign card_image = image | default: collection.featured_image
  assign card_url = collection.url | default: routes.collections_url
  assign card_color = color | default: 'var(--tint-2)'
-%}

<a href="{{ card_url }}" class="collection-card" {{ attributes }}>
  <div class="collection-card__media media-tile" style="--tile-bg: {{ card_color }};">
    {%- if card_image -%}
      {{
        card_image
        | image_url: width: 900
        | image_tag:
          loading: 'lazy',
          widths: '300, 600, 900',
          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 80vw',
          alt: ''
      }}
    {%- else -%}
      {% render 'media-placeholder', kind: 'collection', index: card_title.size, label: card_title %}
    {%- endif -%}
  </div>
  <div class="collection-card__info">
    <div>
      <div class="collection-card__title">{{ card_title | escape }}</div>
      {%- if collection != blank -%}
        <div class="collection-card__count">{{ 'collections.product_count' | t: count: collection.products_count }}</div>
      {%- endif -%}
    </div>
    <span class="collection-card__arrow" aria-hidden="true">{% render 'icon', icon: 'arrow-up-right' %}</span>
  </div>
</a>

{% stylesheet %}
  .collection-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: var(--color-text);
  }
  .collection-card:hover {
    color: var(--color-text);
  }
  .collection-card__media {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
  }
  .collection-card__media img {
    transition: transform 0.5s ease;
  }
  .collection-card:hover .collection-card__media img {
    transform: scale(1.04);
  }
  .collection-card__info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .collection-card__title {
    font-size: 1.125rem;
    font-weight: 600;
  }
  .collection-card__count {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .collection-card__arrow {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    border: 1px solid var(--color-border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .collection-card__arrow .icon {
    width: 18px;
    height: 18px;
  }
  .collection-card:hover .collection-card__arrow {
    background: var(--color-text);
    color: var(--color-surface);
  }
{% endstylesheet %}
