{% doc %}
  Renders a fine line drawing of a bag for frames without a photo. Lines use
  currentColor, and the dashed lines are the stitching.

  @param {string} name - tote, crossbody, backpack, clutch, bucket, satchel, weekender or wallet

  @example
  {% render 'placeholder-art', name: 'tote' %}
{% enddoc %}

