{% doc %}
  Renders an inline stroke SVG icon that inherits the current text color.

  @param {string} icon - Icon name, see the case list below
  @param {string} [class] - Extra class names

  @example
  {% render 'icon', icon: 'cart' %}
{% enddoc %}

{%- liquid
  assign extra_class = class | default: ''
  assign fill_icons = 'star,whatsapp,instagram,tiktok,facebook,youtube' | split: ','
-%}

<svg
  class="icon icon--{{ icon }} {{ extra_class }}"
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 24 24"
  {% if fill_icons contains icon %}
    fill="currentColor"
  {% else %}
    fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
  {% endif %}
>
  {%- case icon -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
    {%- when 'cart' -%}
      <path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-up-right' -%}
      <path d="M7 17L17 7M9 7h8v8"/>
    {%- when 'chevron-down' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'drop' -%}
      <path d="M12 3c4 4 6 7 6 10a6 6 0 0 1-12 0c0-3 2-6 6-10z"/>
    {%- when 'truck' -%}
      <rect x="3" y="7" width="13" height="10" rx="1"/><path d="M16 10h3l2 3v4h-5"/><circle cx="7" cy="18" r="1.5"/><circle cx="18" cy="18" r="1.5"/>
    {%- when 'heart' -%}
      <path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/>
    {%- when 'return' -%}
      <path d="M4 12a8 8 0 1 0 3-6.2"/><path d="M4 4v4h4"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19l7-7"/>
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
    {%- when 'shield' -%}
      <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'eye' -%}
      <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>
    {%- when 'cash' -%}
      <rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 9.5v5M18 9.5v5"/>
    {%- when 'chevron-left' -%}
      <path d="M15 6l-6 6 6 6"/>
    {%- when 'chevron-right' -%}
      <path d="M9 6l6 6-6 6"/>
    {%- when 'globe-pin' -%}
      <path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>
    {%- when 'pause' -%}
      <path d="M9 6v12M15 6v12"/>
    {%- when 'play' -%}
      <path d="M8 5.5v13l10-6.5z"/>
    {%- when 'home' -%}
      <path d="M4 10.5 12 4l8 6.5V20h-5.5v-5.5h-5V20H4z"/>
    {%- when 'sound' -%}
      <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"/>
    {%- when 'drag' -%}
      <path d="M12 3v18M3 12h18M9 6l3-3 3 3M9 18l3 3 3-3M6 9l-3 3 3 3M18 9l3 3-3 3"/>
    {%- when 'gem' -%}
      <path d="M6 4h12l3 5-9 11L3 9z"/><path d="M3 9h18M9 4l3 16 3-16M7.5 9 9 4M16.5 9 15 4"/>
    {%- when 'ruler' -%}
      <rect x="2.5" y="8" width="19" height="8" rx="1"/><path d="M6.5 8v3M10 8v4.5M13.5 8v3M17 8v4.5"/>
    {%- when 'diamond' -%}
      <path d="M12 3l8 9-8 9-8-9z"/>
    {%- when 'check' -%}
      <circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/>
    {%- when 'sparkle' -%}
      <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 16l.7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7z"/>
    {%- when 'flask' -%}
      <path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3"/><path d="M7.5 15h9"/>
    {%- when 'gift' -%}
      <rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12"/><path d="M12 8c-1.5-3-5-3-5-1s3 1 5 1c2 0 5 1 5-1s-3.5-2-5 1z"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'lock' -%}
      <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
    {%- when 'recycle' -%}
      <path d="M7 19H4.5a1.5 1.5 0 0 1-1.3-2.3L5.5 13M17 19h2.5a1.5 1.5 0 0 0 1.3-2.3l-1.6-2.7M9.5 5.6l1.2-2a1.5 1.5 0 0 1 2.6 0l2.2 3.8"/><path d="M7 19h10M5.5 13L3 14M5.5 13l1 2.5M15.5 7.4l-2.7-.2M15.5 7.4l1.2-2.4M19.2 14l-2.7 1.2M19.2 14l.5-2.6"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
    {%- when 'phone' -%}
      <rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/>
    {%- when 'wallet' -%}
      <rect x="3" y="6" width="18" height="13" rx="2"/><path d="M15.5 10.5H21v4h-5.5a2 2 0 0 1 0-4z"/><path d="M6 6l9-3 1 3"/>
    {%- when 'key' -%}
      <circle cx="8" cy="15" r="4"/><path d="M11 12l8-8M16 7l2 2M14 9l2 2"/>
    {%- when 'glasses' -%}
      <circle cx="7" cy="14.5" r="3.5"/><circle cx="17" cy="14.5" r="3.5"/><path d="M10.5 14.5h3M3.6 13.5 5.2 7.5M20.4 13.5 18.8 7.5"/>
    {%- when 'tablet' -%}
      <rect x="4.5" y="2.5" width="15" height="19" rx="2"/><path d="M11 18.5h2"/>
    {%- when 'laptop' -%}
      <rect x="5" y="5" width="14" height="10" rx="1"/><path d="M2.5 19h19l-1.5-4h-16z"/>
    {%- when 'document' -%}
      <path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M9.5 12h6M9.5 15.5h6"/>
    {%- when 'bottle' -%}
      <path d="M10 2.5h4v3l1.5 2.5V20a1.5 1.5 0 0 1-1.5 1.5h-4A1.5 1.5 0 0 1 8.5 20V8L10 5.5z"/><path d="M8.5 11h7"/>
    {%- when 'bag' -%}
      <path d="M5 9h14l-1.2 11.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8z"/><path d="M9 9V7a3 3 0 0 1 6 0v2"/>
    {%- when 'pen' -%}
      <path d="M4 20l1.2-4.2L16 5a2.1 2.1 0 0 1 3 3L8.2 18.8z"/><path d="M14.5 6.5l3 3"/>
    {%- when 'box' -%}
      <path d="M3 7.5L12 3l9 4.5v9L12 21l-9-4.5z"/><path d="M3 7.5L12 12l9-4.5M12 12v9"/>
    {%- when 'star' -%}
      <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z"/>
    {%- when 'whatsapp' -%}
      <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3z"/>
    {%- when 'instagram' -%}
      <path d="M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM21.9 8a6.9 6.9 0 0 0-1.9-4.9A6.9 6.9 0 0 0 15.1 1.2C13.2 1 10.8 1 8.9 1.2A6.9 6.9 0 0 0 4 3.1 6.9 6.9 0 0 0 2.1 8c-.1 1.9-.1 6.1 0 8a6.9 6.9 0 0 0 1.9 4.9 6.9 6.9 0 0 0 4.9 1.9c1.9.1 6.1.1 8 0a6.9 6.9 0 0 0 4.9-1.9 6.9 6.9 0 0 0 1.9-4.9c.1-1.9.1-6.1 0-8zm-2.5 10.1a3 3 0 0 1-1.7 1.7c-1.2.5-4 .4-5.4.4s-4.2.1-5.4-.4a3 3 0 0 1-1.7-1.7c-.5-1.2-.4-4-.4-5.4s-.1-4.2.4-5.4a3 3 0 0 1 1.7-1.7C8.1 5.1 10.9 5.2 12 5.2s4.2-.1 5.4.4a3 3 0 0 1 1.7 1.7c.5 1.2.4 4 .4 5.4s.4 4.2-.1 5.4z"/>
    {%- when 'tiktok' -%}
      <path d="M16.6 2h-3.4v13.6a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9.4a6.3 6.3 0 1 0 5.4 6.2V8.7a8.1 8.1 0 0 0 4.4 1.3V6.6a4.5 4.5 0 0 1-4.4-4.6z"/>
    {%- when 'youtube' -%}
      <path d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.6 2.6 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.6 2.6 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15.1V8.9l5.2 3.1z"/>
    {%- when 'facebook' -%}
      <path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/>
  {%- endcase -%}
</svg>
