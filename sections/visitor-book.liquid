{%- assign form_id = 'VisitorBook-' | append: section.id -%}

<section
  class="section visitor-book color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
>
  <div class="page-width visitor-book__inner">
    {%- if section.settings.label != blank -%}
      <span class="visitor-book__label">{{ section.settings.label | escape }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="visitor-book__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="visitor-book__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', id: form_id, class: 'visitor-book__form', data-signup-id: form_id -%}
      <input type="hidden" name="contact[tags]" value="newsletter,visitor-book">
      <p class="visitor-book__success" role="status" data-signup-success hidden>{{ section.settings.success | escape }}</p>
      <div class="visitor-book__fields" data-signup-fields>
        {%- if form.errors -%}
          <p class="visitor-book__error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <label class="visually-hidden" for="{{ form_id }}-email">{{ 'newsletter.label' | t }}</label>
        <input
          id="{{ form_id }}-email"
          class="visitor-book__input"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder | escape }}"
          autocomplete="email"
          required
        >
        <button type="submit" class="visitor-book__button">{{ section.settings.button_label | escape }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .visitor-book__inner {
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
  }
  .visitor-book__label {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.0625rem;
    color: var(--color-muted);
  }
  .visitor-book__heading {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: calc(clamp(2.25rem, 5vw, 4.5rem) * var(--heading-scale));
    line-height: 1;
    max-width: 16ch;
    text-wrap: balance;
  }
  .visitor-book__text {
    max-width: 36em;
    color: var(--color-body);
  }
  .visitor-book__form {
    width: min(100%, 620px);
    margin-top: 12px;
  }
  .visitor-book__fields {
    display: flex;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid currentColor;
  }
  .visitor-book__input {
    flex: 1;
    min-width: 0;
    min-height: 56px;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-style: italic;
  }
  .visitor-book__input::placeholder {
    color: var(--color-muted);
  }
  .visitor-book__input:focus {
    outline: none;
  }
  .visitor-book__fields:focus-within {
    box-shadow: 0 1px 0 currentColor;
  }
  .visitor-book__button {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.125rem;
    cursor: pointer;
  }
  .visitor-book__error {
    flex-basis: 100%;
    color: var(--color-sale);
  }
  .visitor-book__success {
    font-family: var(--font-heading);
    font-size: 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Visitor book",
  "tag": "div",
  "class": "visitor-book-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "label", "label": "Label", "default": "Visitor book" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sign the visitor book" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Leave your email to hear about new rooms and new bags first.</p>" },
    { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign" },
    { "type": "text", "id": "success", "label": "Thank you message", "default": "Thank you for signing." },
    { "type": "select", "id": "padding_top", "label": "Top padding", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" },
    { "type": "select", "id": "padding_bottom", "label": "Bottom padding", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" }
  ],
  "presets": [{ "name": "Visitor book" }]
}
{% endschema %}
