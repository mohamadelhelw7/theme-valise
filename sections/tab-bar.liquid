{%- if section.settings.enable -%}
  <tab-bar class="tab-bar color-{{ section.settings.color_scheme }}{% unless section.settings.show_labels %} tab-bar--icons{% endunless %}">
    <nav aria-label="{{ 'general.tab_bar.label' | t }}">
      <ul class="tab-bar__list" role="list">
        <li>
          <a class="tab-bar__item" href="{{ routes.root_url }}"{% if template.name == 'index' %} aria-current="page"{% endif %}>
            {% render 'icon', icon: 'home', class: 'tab-bar__icon' %}
            <span class="tab-bar__label">{{ 'general.tab_bar.home' | t }}</span>
          </a>
        </li>
        <li>
          {%- if section.settings.shop_link != blank -%}
            <a class="tab-bar__item" href="{{ section.settings.shop_link }}">
              {% render 'icon', icon: 'menu', class: 'tab-bar__icon' %}
              <span class="tab-bar__label">{{ 'general.tab_bar.shop' | t }}</span>
            </a>
          {%- else -%}
            <button type="button" class="tab-bar__item" data-tab-menu aria-haspopup="dialog">
              {% render 'icon', icon: 'menu', class: 'tab-bar__icon' %}
              <span class="tab-bar__label">{{ 'general.tab_bar.shop' | t }}</span>
            </button>
          {%- endif -%}
        </li>
        <li>
          <a class="tab-bar__item" href="{{ routes.search_url }}" data-tab-search>
            {% render 'icon', icon: 'search', class: 'tab-bar__icon' %}
            <span class="tab-bar__label">{{ 'general.search.title' | t }}</span>
          </a>
        </li>
        {%- if settings.wishlist_enable -%}
          <li>
            <button type="button" class="tab-bar__item" data-modal-open="SavedDrawer" aria-haspopup="dialog">
              {% render 'icon', icon: 'heart', class: 'tab-bar__icon' %}
              <span class="tab-bar__label">{{ 'saved.title' | t }}</span>
              <span class="tab-bar__badge" data-saved-count data-hide-empty hidden>0</span>
            </button>
          </li>
        {%- endif -%}
        <li>
          <a class="tab-bar__item" href="{{ routes.cart_url }}" data-cart-open>
            {% render 'icon', icon: 'cart', class: 'tab-bar__icon' %}
            <span class="tab-bar__label">{{ 'general.header.bag' | t }}</span>
            <span class="tab-bar__badge" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
          </a>
        </li>
      </ul>
    </nav>
  </tab-bar>
{%- endif -%}

{% stylesheet %}
  .tab-bar {
    display: none;
  }
  @media (max-width: 749px) {
    .tab-bar {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 30;
      display: block;
      padding-bottom: env(safe-area-inset-bottom);
      border-top: 1px solid var(--color-border);
      background: color-mix(in srgb, var(--color-bg) 88%, transparent);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      transition: translate 0.3s ease;
    }
    .has-sticky-atc .tab-bar {
      translate: 0 110%;
    }
  }
  .tab-bar__list {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tab-bar__item {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 4px;
    width: 100%;
    min-height: 60px;
    padding: 6px 4px;
    border: 0;
    background: none;
    color: var(--color-muted);
    text-decoration: none;
    cursor: pointer;
  }
  .tab-bar__item[aria-current='page'],
  .tab-bar__item:active {
    color: var(--color-text);
  }
  .tab-bar__item[aria-current='page']::before {
    content: '';
    position: absolute;
    top: 0;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
  }
  .tab-bar__icon {
    width: 22px;
    height: 22px;
  }
  .tab-bar__label {
    font: 700 0.625rem/1 var(--font-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .tab-bar--icons .tab-bar__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .tab-bar__badge {
    position: absolute;
    top: 6px;
    inset-inline-start: calc(50% + 6px);
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font: 700 0.625rem/18px var(--font-label);
    text-align: center;
  }
  .tab-bar__badge[hidden] {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mobile tab bar",
  "tag": "div",
  "class": "tab-bar-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "paragraph", "content": "A bar fixed to the bottom of the screen on phones, like an app: Home, Shop, Search, Saved and Bag. It slides away while the add to cart bar shows." },
    { "type": "checkbox", "id": "enable", "label": "Show the tab bar on phones", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "checkbox", "id": "show_labels", "label": "Show labels under the icons", "default": true },
    { "type": "url", "id": "shop_link", "label": "Shop button link", "info": "Leave empty to open the menu" }
  ],
  "presets": [{ "name": "Mobile tab bar" }]
}
{% endschema %}
