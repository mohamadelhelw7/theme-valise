{
  "type": "footer",
  "name": "Footer",
  "sections": {
    "footer": {
      "type": "footer",
      "blocks": {
        "brand": {
          "type": "_footer-brand",
          "settings": {
            "text": "<p>Bags for every day and every evening, made to be carried for years.</p>"
          }
        },
        "menu_shop": {
          "type": "_footer-menu",
          "settings": {
            "heading": "Shop",
            "menu": "main-menu"
          }
        },
        "menu_help": {
          "type": "_footer-menu",
          "settings": {
            "heading": "Help",
            "menu": "footer"
          }
        },
        "newsletter": {
          "type": "_footer-newsletter",
          "settings": {
            "heading": "Join our list"
          }
        }
      },
      "block_order": [
        "brand",
        "menu_shop",
        "menu_help",
        "newsletter"
      ],
      "settings": {
        "color_scheme": "scheme-3",
        "margin_top": "large",
        "show_localization": true,
        "show_social": true,
        "show_payment_icons": true,
        "show_powered_by": false,
        "show_closing_logo": true,
        "closing_text": "Made to be carried.",
        "closing_height": "small",
        "closing_overlay": 35
      }
    },
    "popup": {
      "type": "popup",
      "settings": {
        "enable": true,
        "content": "newsletter",
        "trigger": "scroll",
        "delay": 8,
        "scroll_percent": 40,
        "frequency": 7,
        "pages": "all",
        "show_mobile": true,
        "position": "corner",
        "layout": "stacked",
        "image_position": "start",
        "dismiss_label": "Not now",
        "color_scheme": "scheme-4",
        "image_shape": "square",
        "eyebrow": "The list",
        "heading": "Hear about new\n*arrivals*",
        "text": "<p>Join our list to hear about new bags first.</p>"
      }
    },
    "tab_bar": {
      "type": "tab-bar",
      "settings": {
        "enable": false,
        "color_scheme": "scheme-1",
        "show_labels": true
      }
    }
  },
  "order": [
    "footer",
    "popup",
    "tab_bar"
  ]
}
