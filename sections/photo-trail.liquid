{%- liquid
  assign heading_lines = section.settings.heading | escape | newline_to_br | split: '<br />'
-%}

<section
  class="section photo-trail-section color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
>
  <photo-trail
    class="photo-trail"
    data-spacing="{{ section.settings.spacing }}"
    style="--trail-h: {{ section.settings.height }}vh; --trail-size: {{ section.settings.photo_size }}px;"
    data-no-reveal
  >
    <div class="photo-trail__items" aria-hidden="true">
      {% content_for 'blocks' %}
    </div>

    <div class="photo-trail__content page-width">
      {%- if section.settings.eyebrow != blank -%}
        <p class="photo-trail__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="photo-trail__heading">
          {%- for line in heading_lines -%}
            {%- assign parts = line | strip | split: '*' -%}
            <span class="photo-trail__line">
              {%- for part in parts -%}
                {%- assign odd = forloop.index0 | modulo: 2 -%}
                {%- if odd == 1 -%}<em>{{ part }}</em>{%- else -%}{{ part }}{%- endif -%}
              {%- endfor -%}
            </span>
          {%- endfor -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="photo-trail__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button button--primary photo-trail__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <p class="photo-trail__hint" aria-hidden="true">
      <span class="photo-trail__hint-mouse">{{ 'sections.photo_trail.hint_mouse' | t }}</span>
      <span class="photo-trail__hint-touch">{{ 'sections.photo_trail.hint_touch' | t }}</span>
    </p>
  </photo-trail>
</section>

{% stylesheet %}
  .photo-trail {
    position: relative;
    display: grid;
    place-items: center;
    min-height: max(var(--trail-h), 420px);
    overflow: hidden;
    isolation: isolate;
    cursor: crosshair;
    touch-action: manipulation;
  }
  .photo-trail__items {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .photo-trail__item {
    --tilt: 0deg;
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--trail-size);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-md);
    opacity: 0;
    translate: -50% -50%;
    rotate: var(--tilt);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.6);
  }
  .photo-trail__item img,
  .photo-trail__item .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-trail__item.is-on {
    animation: trail-pop 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  @keyframes trail-pop {
    0% {
      opacity: 0;
      scale: 0.55;
    }
    12% {
      opacity: 1;
      scale: 1;
    }
    70% {
      opacity: 1;
      scale: 1;
    }
    100% {
      opacity: 0;
      scale: 0.88;
    }
  }
  .photo-trail.is-static .photo-trail__item:nth-child(-n + 5) {
    opacity: 1;
  }
  .photo-trail.is-static .photo-trail__item:nth-child(1) {
    left: 16%;
    top: 30%;
    --tilt: -8deg;
  }
  .photo-trail.is-static .photo-trail__item:nth-child(2) {
    left: 84%;
    top: 26%;
    --tilt: 6deg;
  }
  .photo-trail.is-static .photo-trail__item:nth-child(3) {
    left: 24%;
    top: 78%;
    --tilt: 5deg;
  }
  .photo-trail.is-static .photo-trail__item:nth-child(4) {
    left: 78%;
    top: 76%;
    --tilt: -6deg;
  }
  .photo-trail.is-static .photo-trail__item:nth-child(5) {
    left: 50%;
    top: 14%;
    --tilt: 3deg;
  }
  .photo-trail__content {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
    pointer-events: none;
  }
  .photo-trail__content .button {
    pointer-events: auto;
  }
  .photo-trail__eyebrow {
    margin: 0;
    font: 700 0.75rem/1 var(--font-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .photo-trail__heading {
    display: grid;
    margin: 0;
    font-size: calc(clamp(3rem, 11vw, 10rem) * var(--heading-scale));
    line-height: 0.88;
    letter-spacing: -0.02em;
    mix-blend-mode: difference;
    color: #fff;
  }
  .photo-trail__heading em {
    font-style: normal;
  }
  .photo-trail__text {
    max-width: 440px;
    margin: 0;
    opacity: 0.85;
  }
  .photo-trail__hint {
    position: absolute;
    bottom: 18px;
    left: 50%;
    margin: 0;
    padding: 8px 14px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font: 700 0.6875rem/1 var(--font-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    translate: -50% 0;
    transition: opacity 0.4s ease;
  }
  .photo-trail.is-touched .photo-trail__hint,
  .photo-trail.is-static .photo-trail__hint {
    opacity: 0;
  }
  .photo-trail__hint-touch {
    display: none;
  }
  @media (hover: none), (pointer: coarse) {
    .photo-trail__hint-mouse {
      display: none;
    }
    .photo-trail__hint-touch {
      display: inline;
    }
  }
  @media (max-width: 749px) {
    .photo-trail__item {
      width: calc(var(--trail-size) * 0.6);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Photo trail",
  "tag": "div",
  "class": "photo-trail-wrapper",
  "max_blocks": 16,
  "blocks": [{ "type": "_trail-image" }],
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Photos pop up and fade along the mouse path. On phones they appear where shoppers tap." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The edit" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Wrap a word in *stars* to style it", "default": "Carry it\n*your way*" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to all products" },
    { "type": "range", "id": "height", "label": "Height", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 80 },
    { "type": "range", "id": "photo_size", "label": "Photo size", "min": 160, "max": 360, "step": 20, "unit": "px", "default": 240 },
    { "type": "range", "id": "spacing", "label": "Distance between photos", "min": 40, "max": 200, "step": 10, "unit": "px", "default": 90 },
    { "type": "header", "content": "Spacing" },
    { "type": "select", "id": "padding_top", "label": "Top spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "none" },
    { "type": "select", "id": "padding_bottom", "label": "Bottom spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "none" }
  ],
  "presets": [
    {
      "name": "Photo trail",
      "blocks": [
        { "type": "_trail-image" },
        { "type": "_trail-image" },
        { "type": "_trail-image" },
        { "type": "_trail-image" },
        { "type": "_trail-image" },
        { "type": "_trail-image" },
        { "type": "_trail-image" },
        { "type": "_trail-image" }
      ]
    }
  ]
}
{% endschema %}
