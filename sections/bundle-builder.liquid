{%- comment -%}
  Bundle builder: shoppers fill a set number of slots with products from one or more
  collections (one tab per collection), then add the whole bundle to the cart at once.
  The panel beside the products stays in view on computers and sits at the bottom
  of the screen on phones. A discount only applies when the merchant sets one up in Discounts.
{%- endcomment -%}

{%- liquid
  assign heading_id = 'BundleHeading-' | append: section.id
  assign bb_size = section.settings.bundle_size
  assign bb_cols = section.settings.columns
  case section.settings.image_ratio
    when 'square'
      assign bb_ratio = '1 / 1'
    when 'tall'
      assign bb_ratio = '2 / 3'
    else
      assign bb_ratio = '4 / 5'
  endcase
  assign bb_sizes = '(min-width: 990px) calc((100vw - 480px) / ' | append: bb_cols | append: '), (min-width: 750px) 33vw, 50vw'
  if section.settings.columns_mobile == '1'
    assign bb_sizes = '(min-width: 990px) calc((100vw - 480px) / ' | append: bb_cols | append: '), (min-width: 750px) 33vw, 100vw'
  endif
  assign bb_fallback = section.settings.collection
  if bb_fallback == blank
    assign bb_fallback = collections.all
  endif
  assign bb_label = section.settings.button_label
  if bb_label == blank
    assign bb_label = 'upsells.bundle_add' | t
  endif
-%}

<section
  class="section color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
  {% if section.settings.heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      heading_id: heading_id,
      description: section.settings.description,
      alignment: section.settings.alignment
    %}
    <bundle-builder
      class="bbuild"
      data-size="{{ bb_size }}"
      data-partial="{{ section.settings.partial }}"
      data-count="{{ 'upsells.bundle_count' | t: count: '[count]', size: bb_size | escape }}"
      data-left="{{ 'upsells.bundle_left' | t: count: '[count]' | escape }}"
      data-done="{{ 'upsells.bundle_done' | t | escape }}"
      data-remove="{{ 'upsells.bundle_remove' | t: title: '[title]' | escape }}"
      style="--bb-cols: {{ bb_cols }}; --bb-cols-mobile: {{ section.settings.columns_mobile }}; --bb-ratio: {{ bb_ratio }};"
    >
      <div class="bbuild__shop">
        {%- if section.blocks.size > 1 -%}
          <div class="bbuild__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
            {%- for block in section.blocks -%}
              {%- assign tab_label = block.settings.label | default: block.settings.collection.title | default: forloop.index -%}
              <button
                type="button"
                class="bbuild__tab"
                role="tab"
                id="BundleTab-{{ block.id }}"
                aria-controls="BundlePanel-{{ block.id }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                {% unless forloop.first %}
                  tabindex="-1"
                {% endunless %}
                data-bb-tab
                {{ block.shopify_attributes }}
              >
                {{- tab_label | escape -}}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign tab_collection = block.settings.collection | default: bb_fallback -%}
            <div
              class="bbuild__panel-grid"
              {% if section.blocks.size > 1 %}
                role="tabpanel" id="BundlePanel-{{ block.id }}" aria-labelledby="BundleTab-{{ block.id }}" tabindex="0"
                {% unless forloop.first %}
                  hidden
                {% endunless %}
              {% endif %}
            >
              <ul class="bbuild__grid" role="list">
                {%- for bb_product in tab_collection.products limit: section.settings.products_per_tab -%}
                  {%- unless bb_product.available -%}{%- continue -%}{%- endunless -%}
                  {% render 'upsell-kit-bundle-card', product: bb_product, sizes: bb_sizes %}
                {%- endfor -%}
              </ul>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="bbuild__panel-grid">
            <ul class="bbuild__grid" role="list">
              {%- for bb_product in bb_fallback.products limit: section.settings.products_per_tab -%}
                {%- unless bb_product.available -%}{%- continue -%}{%- endunless -%}
                {% render 'upsell-kit-bundle-card', product: bb_product, sizes: bb_sizes %}
              {%- endfor -%}
            </ul>
          </div>
          {%- if request.design_mode and bb_fallback.products_count == 0 -%}
            <p class="upsell-kit-hint">{{ 'upsells.bundle_none' | t }}</p>
          {%- endif -%}
        {%- endif -%}
      </div>

      <aside class="bbuild__panel" aria-labelledby="BundlePanelTitle-{{ section.id }}">
        <div class="bbuild__panel-head">
          <p class="bbuild__panel-title" id="BundlePanelTitle-{{ section.id }}">{{ 'upsells.bundle_title' | t }}</p>
          <span class="bbuild__count" data-bb-count>{{ 'upsells.bundle_count' | t: count: 0, size: bb_size }}</span>
          <button
            type="button"
            class="bbuild__toggle"
            aria-expanded="false"
            aria-controls="BundleSlots-{{ section.id }}"
            data-bb-toggle
          >
            <span class="visually-hidden">{{ 'upsells.bundle_show' | t }}</span>
            {%- render 'icon', icon: 'chevron-down' -%}
          </button>
        </div>
        <div class="bbuild__meter" aria-hidden="true"><span></span></div>
        <ol class="bbuild__slots" id="BundleSlots-{{ section.id }}" role="list" data-bb-slots>
          {%- for i in (1..bb_size) -%}
            <li class="bbuild__slot is-empty">
              <span class="bbuild__slot-media">{% render 'icon', icon: 'plus' %}</span>
              <span class="bbuild__slot-text">{{ 'upsells.bundle_empty' | t }}</span>
            </li>
          {%- endfor -%}
        </ol>
        <p class="bbuild__status" data-bb-status aria-live="polite">{{ 'upsells.bundle_left' | t: count: bb_size }}</p>
        {%- if section.settings.offer != blank -%}
          <p class="bbuild__offer">
            {%- render 'icon', icon: 'gift' -%}
            <span>{{ section.settings.offer | escape }}</span>
          </p>
        {%- endif -%}
        <div class="bbuild__buy">
          <p class="bbuild__total">
            <span>{{ 'upsells.bundle_total' | t }}</span>
            <span class="bbuild__total-value" data-bb-total>{{ 0 | money }}</span>
          </p>
          <button type="button" class="button button--primary button--full bbuild__add" data-bb-add disabled>
            {{- bb_label | escape -}}
          </button>
        </div>
        <p class="form-message form-message--error" data-form-error role="alert" hidden></p>

        <template data-bb-filled>
          <li class="bbuild__slot">
            <span class="bbuild__slot-media" data-bb-slot-media></span>
            <span class="bbuild__slot-text">
              <span class="bbuild__slot-title" data-bb-slot-title></span>
              <span class="bbuild__slot-variant" data-bb-slot-variant></span>
            </span>
            <span class="bbuild__slot-price" data-bb-slot-price></span>
            <button type="button" class="bbuild__slot-remove" data-bb-remove>{% render 'icon', icon: 'close' %}</button>
          </li>
        </template>
        <template data-bb-empty>
          <li class="bbuild__slot is-empty">
            <span class="bbuild__slot-media">{% render 'icon', icon: 'plus' %}</span>
            <span class="bbuild__slot-text">{{ 'upsells.bundle_empty' | t }}</span>
          </li>
        </template>
      </aside>
    </bundle-builder>
  </div>
</section>

{% javascript %}
  if (!customElements.get('bundle-builder')) {
    class BundleBuilder extends HTMLElement {
      connectedCallback() {
        this.size = Number(this.dataset.size) || 3;
        this.partial = this.dataset.partial === 'true';
        this.picks = [];
        this.slots = this.querySelector('[data-bb-slots]');
        this.filled = this.querySelector('template[data-bb-filled]');
        this.empty = this.querySelector('template[data-bb-empty]');
        this.addButton = this.querySelector('[data-bb-add]');
        this.errorEl = this.querySelector('[data-form-error]');
        this.addEventListener('click', (event) => this.onClick(event));
        this.addEventListener('change', (event) => {
          const select = event.target.closest('[data-bb-variant]');
          if (select) this.syncCard(select.closest('[data-bb-product]'));
        });
        this.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => this.onTabKey(event));
        this.render();
      }

      money(cents) {
        const format = window.theme && window.theme.formatMoney;
        return format ? format(cents) : (cents / 100).toFixed(2);
      }

      choice(card) {
        const select = card.querySelector('select[data-bb-variant]');
        const source = select ? select.selectedOptions[0] : card.querySelector('[data-bb-single]');
        if (!source) return null;
        return {
          id: Number(source.value),
          price: Number(source.dataset.price) || 0,
          image: source.dataset.image || '',
          variant: source.dataset.title || '',
          title: card.dataset.title || '',
          available: !source.disabled,
          card
        };
      }

      syncCard(card) {
        if (!card) return;
        const choice = this.choice(card);
        const price = card.querySelector('[data-bb-price]');
        if (choice && price) price.textContent = this.money(choice.price);
      }

      onClick(event) {
        const tab = event.target.closest('[data-bb-tab]');
        if (tab) {
          this.selectTab(tab);
          return;
        }
        const pick = event.target.closest('[data-bb-pick]');
        if (pick) {
          this.pick(pick.closest('[data-bb-product]'));
          return;
        }
        const remove = event.target.closest('[data-bb-remove]');
        if (remove) {
          this.picks.splice(Number(remove.dataset.bbRemove), 1);
          this.render();
          const next = this.slots.querySelector('[data-bb-remove]');
          (next || this.querySelector('[data-bb-toggle]'))?.focus({ preventScroll: true });
          return;
        }
        const toggle = event.target.closest('[data-bb-toggle]');
        if (toggle) {
          const open = !this.classList.contains('is-open');
          this.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', String(open));
          return;
        }
        if (event.target.closest('[data-bb-add]')) this.add();
      }

      selectTab(tab) {
        this.querySelectorAll('[data-bb-tab]').forEach((other) => {
          const on = other === tab;
          other.setAttribute('aria-selected', String(on));
          other.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(other.getAttribute('aria-controls'));
          if (panel) panel.hidden = !on;
        });
      }

      onTabKey(event) {
        const tabs = Array.from(this.querySelectorAll('[data-bb-tab]'));
        const index = tabs.indexOf(document.activeElement);
        if (index < 0) return;
        const rtl = getComputedStyle(this).direction === 'rtl';
        let next = null;
        if (event.key === 'ArrowRight') next = index + (rtl ? -1 : 1);
        if (event.key === 'ArrowLeft') next = index + (rtl ? 1 : -1);
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = tabs.length - 1;
        if (next === null) return;
        event.preventDefault();
        const tab = tabs[(next + tabs.length) % tabs.length];
        this.selectTab(tab);
        tab.focus();
      }

      pick(card) {
        if (!card || this.picks.length >= this.size) return;
        const choice = this.choice(card);
        if (!choice || !choice.available || !choice.id) return;
        this.picks.push(choice);
        this.render();
        const slot = this.slots.children[this.picks.length - 1];
        if (slot && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) slot.classList.add('is-new');
      }

      render() {
        const fragment = document.createDocumentFragment();
        for (let i = 0; i < this.size; i += 1) {
          const pick = this.picks[i];
          if (!pick) {
            fragment.append(this.empty.content.cloneNode(true));
            continue;
          }
          const slot = this.filled.content.cloneNode(true);
          if (pick.image) {
            const img = document.createElement('img');
            img.src = pick.image;
            img.alt = '';
            img.width = 80;
            img.height = 80;
            slot.querySelector('[data-bb-slot-media]').append(img);
          }
          slot.querySelector('[data-bb-slot-title]').textContent = pick.title;
          const variant = slot.querySelector('[data-bb-slot-variant]');
          variant.textContent = pick.variant;
          variant.hidden = !pick.variant;
          slot.querySelector('[data-bb-slot-price]').textContent = this.money(pick.price);
          const remove = slot.querySelector('[data-bb-remove]');
          remove.dataset.bbRemove = String(i);
          remove.setAttribute('aria-label', (this.dataset.remove || '').replace('[title]', pick.title));
          fragment.append(slot);
        }
        this.slots.replaceChildren(fragment);

        const count = this.picks.length;
        const left = this.size - count;
        const full = left <= 0;
        this.querySelectorAll('[data-bb-count]').forEach((el) => {
          el.textContent = (this.dataset.count || '').replace('[count]', count);
        });
        const status = this.querySelector('[data-bb-status]');
        if (status) status.textContent = full ? this.dataset.done : (this.dataset.left || '').replace('[count]', left);
        const total = this.picks.reduce((sum, pick) => sum + pick.price, 0);
        this.querySelectorAll('[data-bb-total]').forEach((el) => {
          el.textContent = this.money(total);
        });
        this.style.setProperty('--bb-p', String(count / this.size));
        if (this.addButton) this.addButton.disabled = !(full || (this.partial && count > 0));
        this.classList.toggle('is-full', full);
        this.querySelectorAll('[data-bb-product]').forEach((card) => {
          const picked = this.picks.filter((pick) => pick.card === card).length;
          const badge = card.querySelector('[data-bb-badge]');
          if (badge) {
            badge.hidden = picked === 0;
            badge.textContent = '×' + picked;
          }
          card.classList.toggle('is-picked', picked > 0);
          const button = card.querySelector('[data-bb-pick]');
          if (button) button.disabled = full;
        });
      }

      async add() {
        const theme = window.theme;
        if (!this.picks.length || !theme || !theme.addToCart) return;
        const grouped = new Map();
        this.picks.forEach((pick) => grouped.set(pick.id, (grouped.get(pick.id) || 0) + 1));
        const items = Array.from(grouped, ([id, quantity]) => ({ id, quantity }));
        this.addButton.setAttribute('aria-busy', 'true');
        if (this.errorEl) this.errorEl.hidden = true;
        try {
          const data = await theme.addToCart(items);
          this.picks = [];
          this.classList.remove('is-open');
          this.render();
          theme.afterAdd(data);
        } catch (error) {
          if (this.errorEl) {
            this.errorEl.textContent = error.message;
            this.errorEl.hidden = false;
          }
        } finally {
          this.addButton.removeAttribute('aria-busy');
        }
      }
    }
    customElements.define('bundle-builder', BundleBuilder);
  }
{% endjavascript %}

{% stylesheet %}
  .upsell-kit-hint {
    margin: 0;
    padding: 12px;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .upsell-kit-hint[hidden] {
    display: none;
  }
  bundle-builder {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 360px);
    align-items: start;
    gap: clamp(24px, 3vw, 48px);
  }
  .bbuild__shop {
    display: grid;
    gap: 20px;
    min-width: 0;
  }
  .bbuild__tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .bbuild__tabs::-webkit-scrollbar {
    display: none;
  }
  .bbuild__tab {
    flex: none;
    min-height: 40px;
    padding: 0 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--button-radius, 999px);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .bbuild__tab:hover {
    border-color: var(--color-text);
  }
  .bbuild__tab[aria-selected='true'] {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-bg);
  }
  .bbuild__panel-grid[hidden] {
    display: none;
  }
  .bbuild__panel-grid:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .bbuild__grid {
    display: grid;
    grid-template-columns: repeat(var(--bb-cols, 3), minmax(0, 1fr));
    gap: 28px clamp(12px, 1.6vw, 20px);
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* One product */
  .bbuild-card {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .bbuild-card__media {
    position: relative;
    aspect-ratio: var(--bb-ratio, 4 / 5);
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--tint-1);
  }
  .bbuild-card__media > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .bbuild-card.is-picked .bbuild-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 2px var(--color-text);
    pointer-events: none;
  }
  .bbuild-card__badge {
    position: absolute;
    inset-block-start: 8px;
    inset-inline-end: 8px;
    min-width: 28px;
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.75rem;
    font-weight: 700;
    text-align: center;
  }
  .bbuild-card__badge[hidden] {
    display: none;
  }
  .bbuild-card__info {
    display: grid;
    gap: 2px;
  }
  .bbuild-card__title {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .bbuild-card__price {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    margin: 0;
    font-size: 0.875rem;
  }
  .bbuild-card__compare {
    color: var(--color-muted);
  }
  .bbuild-card__select {
    min-height: 38px;
    font-size: 0.8125rem;
  }
  .bbuild-card__add {
    gap: 6px;
  }
  .bbuild-card__add .icon {
    width: 14px;
    height: 14px;
  }
  @media (hover: hover) {
    .bbuild-card:hover .bbuild-card__media > img {
      transform: scale(1.03);
    }
  }

  /* The bundle panel */
  .bbuild__panel {
    position: sticky;
    top: calc(var(--header-height, 0px) + 24px);
    display: grid;
    gap: 14px;
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .bbuild__panel-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .bbuild__panel-title {
    margin: 0;
    margin-inline-end: auto;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: var(--font-heading-weight, 600);
  }
  .bbuild__count {
    font-family: var(--font-label, inherit);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--label-ls);
    text-transform: var(--label-case);
    color: var(--color-muted);
    unicode-bidi: isolate;
  }
  .bbuild__toggle {
    display: none;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .bbuild__toggle .icon {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }
  bundle-builder:not(.is-open) .bbuild__toggle .icon {
    transform: rotate(180deg);
  }
  .bbuild__meter {
    height: 4px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-text) 12%, transparent);
  }
  .bbuild__meter span {
    display: block;
    height: 100%;
    background: var(--color-accent);
    transform: scaleX(var(--bb-p, 0));
    transform-origin: left center;
    transition: transform 0.4s ease;
  }
  [dir='rtl'] .bbuild__meter span {
    transform-origin: right center;
  }
  bundle-builder.is-full .bbuild__meter span {
    background: var(--color-text);
  }
  .bbuild__slots {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bbuild__slot {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 12px;
    min-height: 52px;
  }
  .bbuild__slot.is-new {
    animation: bbuild-in 0.35s ease;
  }
  @keyframes bbuild-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .bbuild__slot-media {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--tint-1);
  }
  .bbuild__slot-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bbuild__slot.is-empty {
    grid-template-columns: 52px minmax(0, 1fr);
    color: var(--color-muted);
  }
  .bbuild__slot.is-empty .bbuild__slot-media {
    border: 1px dashed color-mix(in srgb, var(--color-text) 30%, transparent);
    background: transparent;
  }
  .bbuild__slot.is-empty .icon {
    width: 16px;
    height: 16px;
  }
  .bbuild__slot-text {
    display: grid;
    gap: 1px;
    min-width: 0;
    font-size: 0.8125rem;
  }
  .bbuild__slot-title {
    overflow: hidden;
    font-weight: 500;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .bbuild__slot-variant {
    color: var(--color-muted);
    font-size: 0.75rem;
  }
  .bbuild__slot-variant[hidden] {
    display: none;
  }
  .bbuild__slot-price {
    font-size: 0.8125rem;
    unicode-bidi: isolate;
  }
  .bbuild__slot-remove {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
  }
  .bbuild__slot-remove:hover {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-text) 8%, transparent);
  }
  .bbuild__slot-remove .icon {
    width: 14px;
    height: 14px;
  }
  .bbuild__status {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .bbuild__offer {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .bbuild__offer .icon {
    flex: none;
    width: 18px;
    height: 18px;
  }
  .bbuild__buy {
    display: grid;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
  }
  .bbuild__total {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 0;
    font-weight: 600;
  }
  .bbuild__total-value {
    unicode-bidi: isolate;
  }
  .bbuild__panel .form-message {
    margin: 0;
  }
  .bbuild__panel template {
    display: none;
  }

  @media (max-width: 989px) {
    bundle-builder {
      grid-template-columns: minmax(0, 1fr);
    }
    .bbuild__grid {
      grid-template-columns: repeat(min(var(--bb-cols, 3), 3), minmax(0, 1fr));
    }
    /* On phones and tablets the panel sits at the bottom of the screen while the section is in view */
    .bbuild__panel {
      top: auto;
      bottom: 0;
      z-index: 4;
      gap: 10px;
      padding: 14px 16px calc(14px + env(safe-area-inset-bottom));
      border-radius: var(--radius-md) var(--radius-md) 0 0;
      box-shadow: 0 -10px 30px -12px rgb(0 0 0 / 0.25);
    }
    .bbuild__toggle {
      display: grid;
    }
    bundle-builder:not(.is-open) .bbuild__slots,
    bundle-builder:not(.is-open) .bbuild__offer {
      display: none;
    }
    .bbuild__slots {
      max-height: 40vh;
      overflow-y: auto;
    }
    .bbuild__buy {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      padding-top: 0;
      border-top: 0;
    }
    .bbuild__total {
      display: grid;
      gap: 0;
      font-size: 0.875rem;
    }
    .bbuild__total span:first-child {
      font-size: 0.6875rem;
      font-weight: 500;
      color: var(--color-muted);
    }
  }
  @media (max-width: 749px) {
    .bbuild__grid {
      grid-template-columns: repeat(var(--bb-cols-mobile, 2), minmax(0, 1fr));
      gap: 22px 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bbuild__meter span,
    .bbuild-card__media > img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bundle builder",
  "tag": "div",
  "class": "bundle-builder-section",
  "max_blocks": 6,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Small title", "default": "Bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your bundle" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Pick the pieces you want and add them to your cart together.</p>"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Bundle" },
    { "type": "range", "id": "bundle_size", "label": "Pieces in a bundle", "min": 2, "max": 8, "step": 1, "default": 3 },
    {
      "type": "checkbox",
      "id": "partial",
      "label": "Let shoppers add the bundle before it's full",
      "default": false
    },
    {
      "type": "text",
      "id": "offer",
      "label": "Offer line",
      "info": "Only a real offer you set up in Discounts, for example an amount off when buying this many pieces. Leave empty to hide it."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Leave empty for Add bundle to cart" },
    { "type": "header", "content": "Products" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when there are no tabs. Add Tab blocks to show one collection per tab."
    },
    { "type": "range", "id": "products_per_tab", "label": "Products per tab", "min": 4, "max": 24, "step": 4, "default": 12 },
    { "type": "range", "id": "columns", "label": "Products per row on desktop", "min": 2, "max": 5, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Products per row on phones",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Photo shape",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait 4:5" },
        { "value": "tall", "label": "Tall 2:3" }
      ],
      "default": "portrait"
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab label", "info": "Leave empty to use the collection name" }
      ]
    }
  ],
  "presets": [
    { "name": "Bundle builder" }
  ]
}
{% endschema %}
