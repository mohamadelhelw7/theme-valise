{%- liquid
  assign source = section.settings.source
  assign limit = section.settings.limit
  assign others = blank
  assign needs_load = false
  if source == 'manual'
    assign others = section.settings.products
  elsif recommendations.performed?
    assign others = recommendations.products
  else
    assign needs_load = true
  endif
  assign current_variant = product.selected_or_first_available_variant
  assign shown = 0
-%}

<div class="section color-{{ section.settings.color_scheme }}" style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});">
  <fbt-bundle
    class="page-width"
    data-load="{{ needs_load }}"
    data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&limit={{ limit | plus: 2 }}&intent={{ source }}&section_id={{ section.id }}"
  >
    {%- unless needs_load -%}
      <div class="fbt">
        <div class="fbt__intro">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        </div>

        {%- capture rows -%}
          <li class="fbt__item" data-fbt-item="{{ product.id }}" data-fbt-current data-variant-id="{{ current_variant.id }}" data-price="{{ current_variant.price }}" data-available="{{ current_variant.available }}">
            {% render 'fbt-row', product: product, current: true %}
          </li>
          {%- for other in others -%}
            {%- if other.id == product.id or other.available == false -%}{%- continue -%}{%- endif -%}
            {%- assign other_variant = other.selected_or_first_available_variant -%}
            <li class="fbt__item" data-fbt-item="{{ other.id }}" data-variant-id="{{ other_variant.id }}" data-price="{{ other_variant.price }}" data-available="true">
              {% render 'fbt-row', product: other, current: false %}
            </li>
            {%- assign shown = shown | plus: 1 -%}
            {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if shown > 0 -%}
          <div class="fbt__body">
            <ul class="fbt__thumbs" role="list" aria-hidden="true">
              <li class="fbt__thumb" data-fbt-thumb="{{ product.id }}">
                {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
              </li>
              {%- assign thumb_count = 0 -%}
              {%- for other in others -%}
                {%- if other.id == product.id or other.available == false -%}{%- continue -%}{%- endif -%}
                <li class="fbt__plus">{% render 'icon', icon: 'plus' %}</li>
                <li class="fbt__thumb" data-fbt-thumb="{{ other.id }}">
                  {%- if other.featured_media -%}{{ other.featured_media | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
                </li>
                {%- assign thumb_count = thumb_count | plus: 1 -%}
                {%- if thumb_count >= limit -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
            </ul>

            <ul class="fbt__list" role="list">
              {{ rows }}
            </ul>

            <div class="fbt__footer">
              <div>
                <span class="fbt__total-label">{{ 'sections.fbt.total' | t }}</span>
                <span class="fbt__total" data-fbt-total></span>
              </div>
              <button type="button" class="button button--primary" data-fbt-add>
                <span data-fbt-label data-template="{{ 'sections.fbt.add_count' | t: count: '[count]' | escape }}">{{ 'sections.fbt.add' | t }}</span>
              </button>
              <p class="form-message form-message--error" data-form-error role="alert" hidden></p>
            </div>
          </div>
        {%- elsif request.design_mode -%}
          <p class="fbt__empty">{{ 'sections.fbt.empty' | t }}</p>
        {%- endif -%}
      </div>
    {%- endunless -%}
  </fbt-bundle>
</div>

{% stylesheet %}
  .fbt {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: 24px 48px;
    align-items: start;
  }
  .fbt__intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fbt__body {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: clamp(16px, 3vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .fbt__thumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fbt__thumb {
    width: 96px;
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--tint-1);
    transition: opacity 0.2s;
  }
  .fbt__thumb.is-off {
    opacity: 0.3;
  }
  .fbt__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fbt__plus {
    color: var(--color-muted);
    display: inline-flex;
  }
  .fbt__plus .icon {
    width: 16px;
    height: 16px;
  }
  .fbt__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .fbt__item {
    border-top: 1px solid var(--color-border);
  }
  .fbt__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    border-top: 1px solid var(--color-border);
    padding-top: 18px;
  }
  .fbt__total-label {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .fbt__total {
    font-size: 1.375rem;
    font-weight: 600;
  }
  .fbt__footer .form-message {
    flex-basis: 100%;
  }
  .fbt__empty {
    color: var(--color-muted);
  }
  @media (max-width: 989px) {
    .fbt {
      grid-template-columns: 1fr;
    }
    .fbt__thumb {
      width: 72px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bought together",
  "tag": "section",
  "class": "fbt-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete the look" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently bought together" },
    {
      "type": "select",
      "id": "source",
      "label": "Products to show",
      "options": [
        { "value": "complementary", "label": "Complementary products" },
        { "value": "related", "label": "Related products" },
        { "value": "manual", "label": "Pick products" }
      ],
      "default": "complementary",
      "info": "Set complementary products for each product in the Shopify Search & Discovery app"
    },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 4, "info": "Used with Pick products" },
    { "type": "range", "id": "limit", "label": "Products added to the bundle", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "header", "content": "Spacing" },
    { "type": "select", "id": "padding_top", "label": "Top spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" },
    { "type": "select", "id": "padding_bottom", "label": "Bottom spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "none" }
  ],
  "presets": [{ "name": "Bought together" }]
}
{% endschema %}
