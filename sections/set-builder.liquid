<section
  class="section color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
>
  <set-builder class="page-width set-builder" data-required="{{ section.settings.require_full }}">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      description: section.settings.description,
      alignment: section.settings.header_alignment
    %}

    {%- if section.blocks.size > 0 -%}
      <tab-list class="pill-tabs pill-tabs--pills set-builder__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          <button
            type="button"
            role="tab"
            class="pill-tabs__tab"
            id="SetTab-{{ block.id }}"
            aria-controls="SetPanel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          >
            {{- block.settings.label | default: block.settings.collection.title | escape -}}
          </button>
        {%- endfor -%}
      </tab-list>
    {%- endif -%}

    <div class="set-builder__panels">
      {% content_for 'blocks' %}
    </div>

    <div class="set-builder__bar color-{{ section.settings.panel_scheme }}">
      <div class="set-builder__intro">
        <p class="set-builder__bar-heading">{{ section.settings.bar_heading | escape }}</p>
        {%- if section.settings.bar_text != blank -%}
          <p class="set-builder__bar-text">{{ section.settings.bar_text | escape }}</p>
        {%- endif -%}
      </div>
      <ol class="set-builder__slots" role="list">
        {%- for block in section.blocks -%}
          <li class="set-slot" data-set-slot>
            <span class="set-slot__frame">
              <img hidden alt="" width="120" height="120">
              <span class="set-slot__number" aria-hidden="true">{{ forloop.index }}</span>
            </span>
            <span class="set-slot__meta">
              <span class="set-slot__label">{{ block.settings.label | default: block.settings.collection.title | escape }}</span>
              <span class="set-slot__title" data-slot-title></span>
            </span>
            <button
              type="button"
              class="set-slot__remove"
              data-set-remove="{{ forloop.index0 }}"
              aria-label="{{ 'sections.set_builder.remove' | t }}"
              hidden
            >
              {% render 'icon', icon: 'close' %}
            </button>
          </li>
        {%- endfor -%}
      </ol>
      <div class="set-builder__summary">
        <p class="set-builder__total">
          <span>{{ 'sections.set_builder.total' | t }}</span>
          <span class="set-builder__total-value" data-set-total>{% render 'format-money', amount: 0 %}</span>
        </p>
        <button type="button" class="button button--primary set-builder__add" data-set-add disabled>
          {{- section.settings.button_label | escape -}}
        </button>
        <p class="form-message form-message--error" data-form-error role="alert" hidden></p>
      </div>
    </div>
  </set-builder>
</section>

{% stylesheet %}
  set-builder {
    display: block;
  }
  .set-builder__tabs {
    display: flex;
    justify-content: center;
    margin: 0 auto 28px;
    width: fit-content;
  }
  .set-step__slider {
    position: relative;
  }
  .set-step__arrows {
    display: flex;
    justify-content: center;
    margin-top: 20px;
  }
  .set-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: center;
    background: var(--color-surface);
    padding: 14px 14px 16px;
    transition: box-shadow 0.25s ease;
  }
  .set-item.is-picked {
    box-shadow: inset 0 0 0 1.5px var(--color-accent);
  }
  .set-item__media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--tint-1);
  }
  .set-item__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .set-item__title {
    font-size: var(--card-title-size);
    text-transform: var(--card-title-case);
    letter-spacing: var(--card-title-ls);
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .set-item__price {
    font-size: 0.875rem;
    color: var(--color-body);
  }
  .set-item__select {
    min-height: 40px;
    font-size: 0.8125rem;
  }
  .set-item__add {
    margin-top: auto;
  }
  .set-item__added-label {
    display: none;
    align-items: center;
    gap: 6px;
  }
  .set-item__added-label .icon {
    width: 16px;
    height: 16px;
  }
  .set-item.is-picked .set-item__add-label {
    display: none;
  }
  .set-item.is-picked .set-item__added-label {
    display: inline-flex;
  }
  .set-builder__bar {
    margin-top: 32px;
    padding: 22px 28px;
    display: grid;
    grid-template-columns: minmax(180px, 0.8fr) minmax(0, 2fr) auto;
    gap: 24px;
    align-items: center;
    box-shadow: 0 20px 50px -40px rgb(0 0 0 / 0.5);
  }
  .set-builder__bar-heading {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    text-transform: var(--heading-case);
    letter-spacing: var(--heading-ls);
  }
  .set-builder__bar-text {
    margin-top: 4px;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .set-builder__slots {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .set-slot {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1 1 0;
    min-width: 150px;
  }
  .set-slot + .set-slot::before {
    content: '+';
    position: absolute;
    inset-inline-start: -20px;
    top: 50%;
    translate: 0 -50%;
    color: var(--color-muted);
  }
  .set-slot__frame {
    position: relative;
    width: 64px;
    height: 64px;
    flex: none;
    border: 1px dashed var(--color-border);
    display: grid;
    place-items: center;
    background: var(--color-bg);
  }
  .set-slot.is-filled .set-slot__frame {
    border-style: solid;
  }
  .set-slot__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .set-slot__number {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .set-slot.is-filled .set-slot__number {
    display: none;
  }
  .set-slot__meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .set-slot__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--label-ls);
    text-transform: var(--label-case);
    color: var(--color-muted);
  }
  .set-slot__title {
    font-size: 0.8125rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 16ch;
  }
  .set-slot__remove {
    position: absolute;
    top: -8px;
    inset-inline-start: 52px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    display: grid;
    place-items: center;
    padding: 0;
    cursor: pointer;
  }
  .set-slot__remove[hidden] {
    display: none;
  }
  .set-slot__remove .icon {
    width: 12px;
    height: 12px;
  }
  .set-builder__summary {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    min-width: 200px;
  }
  .set-builder__total {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.875rem;
  }
  .set-builder__total-value {
    font-weight: 600;
  }
  @media (max-width: 989px) {
    .set-builder__bar {
      grid-template-columns: 1fr;
      padding: 20px;
      position: sticky;
      bottom: 0;
      z-index: 5;
    }
    .set-builder__intro {
      display: none;
    }
    .set-builder__slots {
      gap: 22px;
    }
    .set-slot {
      min-width: 64px;
      flex: 0 0 auto;
    }
    .set-slot__meta {
      display: none;
    }
    .set-slot + .set-slot::before {
      inset-inline-start: -16px;
    }
    .set-builder__summary {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
    .set-builder__total {
      flex: 1;
      flex-direction: column;
      gap: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Set builder",
  "tag": "div",
  "class": "set-builder-section",
  "max_blocks": 5,
  "blocks": [{ "type": "_set-step" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "color_scheme", "id": "panel_scheme", "label": "Set bar color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your set" },
    { "type": "inline_richtext", "id": "description", "label": "Description", "default": "Pick a bag, a wallet and a small extra, then add the whole set at once." },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading layout",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "split", "label": "Split with accent line" }
      ],
      "default": "split"
    },
    { "type": "range", "id": "products_per_step", "label": "Products per step", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Products in view", "min": 2, "max": 6, "step": 1, "default": 5 },
    { "type": "header", "content": "Set bar" },
    { "type": "text", "id": "bar_heading", "label": "Heading", "default": "Your set" },
    { "type": "text", "id": "bar_text", "label": "Text", "default": "Choose a piece in each step to complete your set." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add set to bag" },
    { "type": "checkbox", "id": "require_full", "label": "Only allow complete sets", "info": "When off, shoppers can add the set with at least one piece. To give a set discount, create an automatic discount in Shopify admin.", "default": false },
    { "type": "header", "content": "Spacing" },
    { "type": "select", "id": "padding_top", "label": "Top spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" },
    { "type": "select", "id": "padding_bottom", "label": "Bottom spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" }
  ],
  "presets": [
    {
      "name": "Set builder",
      "blocks": [
        { "type": "_set-step", "settings": { "label": "Bag" } },
        { "type": "_set-step", "settings": { "label": "Wallet" } },
        { "type": "_set-step", "settings": { "label": "Pouch" } },
        { "type": "_set-step", "settings": { "label": "Extra" } }
      ]
    }
  ]
}
{% endschema %}
