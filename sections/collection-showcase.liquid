{%- liquid
  assign source = section.settings.collection | default: collections.all
  assign limit = section.settings.limit
-%}

<section
  class="section color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
>
  <div class="page-width showcase showcase--images-{{ section.settings.image_position }}">
    <div class="showcase__images">
      {% content_for 'blocks' %}
    </div>

    <card-slider class="showcase__products">
      {% render 'section-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        description: section.settings.description,
        alignment: section.settings.header_alignment,
        slider: true
      %}
      <ul
        class="slider-track slider-track--products"
        role="list"
        data-slider-track
        style="--slider-cols: {{ section.settings.columns }};"
      >
        {%- for product in source.products limit: limit -%}
          <li>{% render 'product-card', product: product, index: forloop.index %}</li>
        {%- else -%}
          {%- for i in (1..3) -%}
            <li>{% render 'product-card', product: blank, index: i %}</li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
      {%- if section.settings.button_label != blank -%}
        <div class="showcase__button">
          <a class="button button--primary" href="{{ source.url }}">
            {{- section.settings.button_label | escape }}
            {% render 'icon', icon: 'arrow-up-right' %}
          </a>
        </div>
      {%- endif -%}
    </card-slider>
  </div>
</section>

{% stylesheet %}
  .showcase {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }
  .showcase--images-end .showcase__images {
    order: 2;
  }
  .showcase__images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap);
  }
  .showcase__images:has(> :only-child) {
    grid-template-columns: 1fr;
  }
  .showcase-tile {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-surface);
  }
  .showcase-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.7s ease;
  }
  .showcase-tile:hover img {
    scale: 1.05;
  }
  .showcase-tile__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .showcase-tile__label {
    position: absolute;
    inset-inline-start: 12px;
    bottom: 12px;
    padding: 6px 10px;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--label-ls);
    text-transform: var(--label-case);
  }
  .showcase__products {
    min-width: 0;
  }
  .showcase__button {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }
  @media (max-width: 989px) {
    .showcase {
      grid-template-columns: 1fr;
    }
    .showcase--images-end .showcase__images {
      order: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection showcase",
  "tag": "div",
  "class": "collection-showcase-section",
  "max_blocks": 4,
  "blocks": [{ "type": "_showcase-image" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "inline_richtext", "id": "description", "label": "Description", "default": "Bags picked for workdays, weekends and evenings out." },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading layout",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "split", "label": "Split with accent line" }
      ],
      "default": "split"
    },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use all products" },
    { "type": "range", "id": "limit", "label": "Products", "min": 3, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Products in view", "min": 2, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "image_position",
      "label": "Photos position",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "end", "label": "End" }
      ],
      "default": "start"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all" },
    { "type": "header", "content": "Spacing" },
    { "type": "select", "id": "padding_top", "label": "Top spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" },
    { "type": "select", "id": "padding_bottom", "label": "Bottom spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "none" }
  ],
  "presets": [
    {
      "name": "Collection showcase",
      "blocks": [
        { "type": "_showcase-image" },
        { "type": "_showcase-image" },
        { "type": "_showcase-image" },
        { "type": "_showcase-image" }
      ]
    }
  ]
}
{% endschema %}
