{%- liquid
  assign look_image = section.settings.image
-%}

<section
  class="section color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
>
  <look-book class="page-width look look--image-{{ section.settings.image_position }}">
    <div class="look__media">
      {%- if look_image != blank -%}
        {{
          look_image
          | image_url: width: 1800
          | image_tag: widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 990px) 60vw, 100vw', loading: 'lazy', alt: look_image.alt
        }}
      {%- else -%}
        {% render 'media-placeholder', kind: 'lifestyle', index: 2 %}
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- assign dot_product = block.settings.product | default: collections.all.products[forloop.index0] -%}
        <button
          type="button"
          class="look__dot"
          style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;"
          data-look-dot="{{ forloop.index0 }}"
          aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="{{ 'sections.shop_the_look.show' | t: title: dot_product.title | escape }}"
        >
          <span></span>
        </button>
      {%- endfor -%}
    </div>

    <div class="look__panel">
      {% render 'section-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        description: section.settings.description,
        alignment: 'center'
      %}
      <div class="look__products">
        {% content_for 'blocks' %}
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="look__nav">
          <button type="button" class="round-button" data-look-prev aria-label="{{ 'general.slider.previous' | t }}">
            {% render 'icon', icon: 'chevron-left' %}
          </button>
          <span class="look__counter" data-look-counter>1 / {{ section.blocks.size }}</span>
          <button type="button" class="round-button" data-look-next aria-label="{{ 'general.slider.next' | t }}">
            {% render 'icon', icon: 'chevron-right' %}
          </button>
        </div>
      {%- endif -%}
    </div>
  </look-book>
</section>

{% stylesheet %}
  look-book {
    display: grid;
  }
  .look {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: center;
  }
  .look--image-end .look__media {
    order: 2;
  }
  .look__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
  }
  .look__media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .look__dot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    translate: -50% -50%;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: rgb(255 255 255 / 0.35);
    display: grid;
    place-items: center;
    z-index: 1;
  }
  .look__dot span {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.25);
    transition: scale 0.2s ease;
  }
  .look__dot[aria-pressed='true'] span {
    scale: 1.25;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px #fff;
  }
  .look__dot[aria-pressed='true']::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid #fff;
    animation: look-pulse 1.8s ease-out infinite;
  }
  @keyframes look-pulse {
    from {
      scale: 0.6;
      opacity: 1;
    }
    to {
      scale: 1.6;
      opacity: 0;
    }
  }
  .look__panel {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .look__panel .section-header .h2 {
    padding-bottom: 14px;
    background: linear-gradient(var(--color-accent), var(--color-accent)) center bottom / 48px 2px no-repeat;
  }
  .look__products {
    max-width: 360px;
    width: 100%;
    margin-inline: auto;
  }
  .look__item[hidden] {
    display: none;
  }
  .look__item {
    animation: look-in 0.5s ease both;
  }
  @keyframes look-in {
    from {
      opacity: 0;
      translate: 0 12px;
    }
    to {
      opacity: 1;
      translate: none;
    }
  }
  .look__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 20px;
  }
  .look__counter {
    font-size: 0.8125rem;
    color: var(--color-muted);
    min-width: 48px;
    text-align: center;
  }
  @media (max-width: 989px) {
    .look {
      grid-template-columns: 1fr;
    }
    .look--image-end .look__media {
      order: 0;
    }
    .look__media {
      aspect-ratio: 4 / 5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop the look",
  "tag": "div",
  "class": "shop-the-look-section",
  "max_blocks": 6,
  "blocks": [{ "type": "_hotspot" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Look photo", "info": "Add a product dot for each piece in the photo, then move it into place" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Photo position",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "end", "label": "End" }
      ],
      "default": "start"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the look" },
    { "type": "inline_richtext", "id": "description", "label": "Description", "default": "Tap a dot to see each piece in this look." },
    { "type": "header", "content": "Spacing" },
    { "type": "select", "id": "padding_top", "label": "Top spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" },
    { "type": "select", "id": "padding_bottom", "label": "Bottom spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "none" }
  ],
  "presets": [
    {
      "name": "Shop the look",
      "blocks": [
        { "type": "_hotspot", "settings": { "x": 36, "y": 44 } },
        { "type": "_hotspot", "settings": { "x": 58, "y": 68 } },
        { "type": "_hotspot", "settings": { "x": 74, "y": 30 } }
      ]
    }
  ]
}
{% endschema %}
