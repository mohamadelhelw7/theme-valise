<rail-scroll class="rail color-{{ section.settings.color_scheme }}" data-no-reveal>
  <div class="rail__sticky" data-rail-sticky>
    <div class="rail__head page-width">
      {% render 'section-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        description: section.settings.description,
        alignment: section.settings.header_alignment,
        link_url: section.settings.link,
        link_label: section.settings.link_label
      %}
    </div>
    <div class="rail__viewport">
      <ul class="rail__track" data-rail-track role="list">
        {% content_for 'blocks' %}
      </ul>
    </div>
    <div class="rail__progress page-width" aria-hidden="true"><span data-rail-progress></span></div>
  </div>
</rail-scroll>

{% stylesheet %}
  rail-scroll {
    display: block;
    position: relative;
  }
  .rail__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 560px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    overflow: hidden;
    padding-block: 6vh;
  }
  .rail__head .section-header {
    margin-bottom: 0;
  }
  .rail__viewport {
    --rail-start: max(var(--gutter), calc((100vw - var(--page-width)) / 2 + var(--gutter)));
  }
  .rail__track {
    display: flex;
    gap: clamp(16px, 2vw, 32px);
    width: max-content;
    margin: 0;
    padding: 0 var(--rail-start);
    list-style: none;
    will-change: transform;
  }
  .rail-item {
    position: relative;
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rail-item__media {
    height: min(54vh, 560px);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-surface);
  }
  .rail-item--landscape .rail-item__media {
    aspect-ratio: 4 / 3;
  }
  .rail-item--arch .rail-item__media {
    border-radius: 999px 999px var(--radius-sm) var(--radius-sm);
  }
  .rail-item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.8s ease;
  }
  .rail-item:hover .rail-item__media img {
    scale: 1.05;
  }
  .rail-item__caption {
    display: flex;
    gap: 14px;
    align-items: baseline;
  }
  .rail-item__number {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }
  .rail-item__title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    line-height: 1.2;
  }
  .rail-item__subtitle {
    margin-top: 2px;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .rail-item__link {
    position: absolute;
    inset: 0;
  }
  .rail__progress {
    width: 100%;
  }
  .rail__progress span {
    display: block;
    height: 1px;
    background: var(--color-text);
    transform-origin: left center;
    transform: scaleX(0);
  }
  [dir='rtl'] .rail__progress span {
    transform-origin: right center;
  }
  .rail__progress {
    background: linear-gradient(var(--color-border), var(--color-border)) center / 100% 1px no-repeat;
  }
  .rail.is-static {
    height: auto;
  }
  .rail.is-static .rail__sticky {
    position: static;
    height: auto;
    min-height: 0;
    padding-block: var(--space-large);
  }
  .rail.is-static .rail__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .rail.is-static .rail__viewport::-webkit-scrollbar {
    display: none;
  }
  .rail.is-static .rail__track {
    transform: none;
  }
  .rail.is-static .rail-item {
    scroll-snap-align: start;
    scroll-margin-inline: var(--rail-start);
  }
  .rail.is-static .rail__progress {
    display: none;
  }
  @media (max-width: 749px) {
    .rail-item__media {
      height: auto;
      width: 72vw;
    }
    .rail-item--landscape .rail-item__media {
      width: 86vw;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Horizontal lookbook",
  "tag": "section",
  "class": "lookbook-rail-section",
  "max_blocks": 12,
  "blocks": [{ "type": "_rail-item" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "paragraph", "content": "On desktop, scrolling down moves the looks sideways. On phones they become a swipe row." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The lookbook" },
    { "type": "inline_richtext", "id": "description", "label": "Description", "default": "Six bags from the new collection, from the office to the weekend." },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading layout",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "split", "label": "Split with accent line" }
      ],
      "default": "start"
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop the collection" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [
    {
      "name": "Horizontal lookbook",
      "blocks": [
        { "type": "_rail-item", "settings": { "title": "The office", "shape": "arch" } },
        { "type": "_rail-item", "settings": { "title": "Weekend", "shape": "landscape" } },
        { "type": "_rail-item", "settings": { "title": "Dinner", "shape": "portrait" } },
        { "type": "_rail-item", "settings": { "title": "Travel", "shape": "arch" } },
        { "type": "_rail-item", "settings": { "title": "City walk", "shape": "landscape" } },
        { "type": "_rail-item", "settings": { "title": "Evening", "shape": "portrait" } }
      ]
    }
  ]
}
{% endschema %}
