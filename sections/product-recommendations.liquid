<product-recommendations-loader
  class="section color-{{ section.settings.color_scheme }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-header{% if section.settings.header_alignment == 'center' %} section-header--center{% endif %}">
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      </div>
      <ul class="product-grid{% if section.settings.mobile_layout == 'swipe' %} product-grid--swipe{% endif %}" role="list" style="--cols-desktop: {{ section.settings.limit | at_most: 4 }};">
        {%- for rec in recommendations.products -%}
          <li>{% render 'product-card', product: rec, index: forloop.index %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</product-recommendations-loader>

{% javascript %}
  class ProductRecommendationsLoader extends HTMLElement {
    connectedCallback() {
      if (this.children.length) return;
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting) return;
          observer.disconnect();
          fetch(this.dataset.url)
            .then((r) => r.text())
            .then((html) => {
              const doc = new DOMParser().parseFromString(html, 'text/html');
              const next = doc.querySelector('product-recommendations-loader');
              if (next && next.innerHTML.trim()) this.innerHTML = next.innerHTML;
            })
            .catch(() => {});
        },
        { rootMargin: '0px 0px 400px 0px' }
      );
      observer.observe(this);
    }
  }
  if (!customElements.get('product-recommendations-loader')) {
    customElements.define('product-recommendations-loader', ProductRecommendationsLoader);
  }
{% endjavascript %}

{% stylesheet %}
  product-recommendations-loader:not(:has(.page-width)) {
    padding: 0;
  }
  product-recommendations-loader {
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product recommendations",
  "tag": "div",
  "class": "product-recommendations-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pairs well with"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        {
          "value": "related",
          "label": "Related"
        },
        {
          "value": "complementary",
          "label": "Complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Layout on mobile",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "swipe",
          "label": "Swipe row"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top spacing",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
