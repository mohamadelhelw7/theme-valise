{%- liquid
  assign threshold = section.settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign progress = 0
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
  endif

  assign in_cart = ','
  for item in cart.items
    assign in_cart = in_cart | append: item.product_id | append: ','
  endfor
-%}

<cart-drawer data-section-id="{{ section.id }}">
  <dialog class="modal drawer cart-drawer color-{{ section.settings.color_scheme }}" aria-labelledby="CartDrawerTitle">
    <div class="cart-drawer__inner" data-cart-drawer-inner data-cart-item-count="{{ cart.item_count }}">
      <div class="cart-drawer__header">
        <h2 id="CartDrawerTitle" class="h3">
          {{ 'cart.title' | t }}
          <span class="cart-drawer__count">({{ cart.item_count }})</span>
        </h2>
        <button type="button" class="icon-button" data-modal-close aria-label="{{ 'general.accessibility.close' | t }}">
          {% render 'icon', icon: 'close' %}
        </button>
      </div>

      {%- if threshold > 0 and cart.item_count > 0 -%}
        <div class="cart-drawer__shipping">
          <p>
            {%- if remaining > 0 -%}
              {%- capture remaining_money -%}{% render 'format-money', amount: remaining %}{%- endcapture -%}
              {{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}
            {%- else -%}
              {{ 'cart.free_shipping_unlocked' | t }}
            {%- endif -%}
          </p>
          <div class="cart-drawer__progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}" aria-label="{{ 'cart.free_shipping_progress' | t }}">
            <span style="width: {{ progress }}%;"></span>
          </div>
        </div>
      {%- endif -%}

      {%- if cart.item_count > 0 -%}
        <div class="cart-drawer__body">
          <ul class="cart-drawer__items" role="list">
            {%- for item in cart.items -%}
              <li class="cart-item">
                <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                  {%- else -%}
                    {% render 'media-placeholder', kind: 'product', index: forloop.index %}
                  {%- endif -%}
                </a>
                <div class="cart-item__details">
                  <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="cart-item__variant">{{ item.variant.title | escape }}</p>
                  {%- endunless -%}
                  {%- for property in item.properties -%}
                    {%- assign first_char = property.first | slice: 0 -%}
                    {%- if property.last != blank and first_char != '_' -%}
                      <p class="cart-item__variant">{{ property.first }}: {{ property.last }}</p>
                    {%- endif -%}
                  {%- endfor -%}
                  {%- for discount in item.line_level_discount_allocations -%}
                    <p class="cart-item__discount">{{ discount.discount_application.title | escape }} (-{% render 'format-money', amount: discount.amount %})</p>
                  {%- endfor -%}
                  <div class="cart-item__row">
                    <quantity-input class="quantity">
                      <button
                        type="button"
                        class="quantity__button"
                        data-line-change
                        data-line="{{ forloop.index }}"
                        data-quantity="{{ item.quantity | minus: 1 }}"
                        aria-label="{{ 'cart.decrease' | t: title: item.product.title | escape }}"
                      >
                        {% render 'icon', icon: 'minus' %}
                      </button>
                      <label class="visually-hidden" for="DrawerQty-{{ forloop.index }}">{{ 'cart.quantity' | t }}</label>
                      <input
                        id="DrawerQty-{{ forloop.index }}"
                        class="quantity__input"
                        type="number"
                        min="0"
                        value="{{ item.quantity }}"
                        data-line-input
                        data-line="{{ forloop.index }}"
                      >
                      <button
                        type="button"
                        class="quantity__button"
                        data-line-change
                        data-line="{{ forloop.index }}"
                        data-quantity="{{ item.quantity | plus: 1 }}"
                        aria-label="{{ 'cart.increase' | t: title: item.product.title | escape }}"
                      >
                        {% render 'icon', icon: 'plus' %}
                      </button>
                    </quantity-input>
                    <div class="cart-item__price">
                      {%- if item.original_line_price != item.final_line_price -%}
                        <s class="price__compare">{% render 'format-money', amount: item.original_line_price %}</s>
                      {%- endif -%}
                      <span class="price__current">{% render 'format-money', amount: item.final_line_price %}</span>
                    </div>
                  </div>
                  <button
                    type="button"
                    class="cart-item__remove"
                    data-line-change
                    data-line="{{ forloop.index }}"
                    data-quantity="0"
                  >
                    {{- 'cart.remove' | t -}}
                  </button>
                </div>
              </li>
            {%- endfor -%}
          </ul>

          {%- if section.settings.show_upsell -%}
            {%- if section.settings.upsell_source == 'manual' -%}
              {%- capture manual_upsells -%}
                {%- for upsell in section.settings.upsell_products -%}
                  {%- assign needle = ',' | append: upsell.id | append: ',' -%}
                  {%- unless in_cart contains needle -%}
                    {% render 'upsell-item', product: upsell %}
                  {%- endunless -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- if manual_upsells != blank -%}
                <div class="cart-upsell">
                  <p class="cart-upsell__heading">{{ section.settings.upsell_heading | escape }}</p>
                  <div class="cart-upsell__list">{{ manual_upsells }}</div>
                </div>
              {%- endif -%}
            {%- else -%}
              <cart-upsell
                class="cart-upsell"
                data-url="{{ routes.product_recommendations_url }}?product_id={{ cart.items.first.product_id }}&limit=6&intent={{ section.settings.upsell_source }}&section_id=cart-upsell"
                hidden
              >
                <p class="cart-upsell__heading">{{ section.settings.upsell_heading | escape }}</p>
                <div class="cart-upsell__list" data-cart-upsell-target></div>
              </cart-upsell>
            {%- endif -%}
          {%- endif -%}
        </div>

        <div class="cart-drawer__footer">
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-drawer__line">
              <span>{{ discount.title | escape }}</span>
              <span>-{% render 'format-money', amount: discount.total_allocated_amount %}</span>
            </div>
          {%- endfor -%}
          <div class="cart-drawer__line cart-drawer__total">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{% render 'format-money', amount: cart.total_price, with_code: true %}</span>
          </div>
          <p class="cart-drawer__note">{{ 'cart.taxes_and_shipping' | t }}</p>
          <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__actions">
            <button type="submit" name="checkout" class="button button--primary button--full">
              {% render 'icon', icon: 'lock' %}
              {{ 'cart.checkout' | t }}
            </button>
            {%- if section.settings.show_view_cart -%}
              <a href="{{ routes.cart_url }}" class="button button--secondary button--full">{{ 'cart.view_cart' | t }}</a>
            {%- endif -%}
          </form>
          {%- if settings.cart_show_payment_icons and shop.enabled_payment_types.size > 0 -%}
            <ul class="cart-drawer__payments" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'cart-drawer__payment-icon' }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="empty-state cart-drawer__empty">
          <p>{{ 'cart.empty' | t }}</p>
          <a href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}" class="button button--primary">
            {{- 'cart.continue_shopping' | t -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </dialog>
</cart-drawer>

{% stylesheet %}
  .cart-drawer {
    width: min(440px, 100vw);
  }
  cart-drawer[aria-busy='true'] .cart-drawer__inner {
    opacity: 0.6;
    pointer-events: none;
  }
  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: opacity 0.2s;
  }
  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    border-bottom: 1px solid var(--color-border);
  }
  .cart-drawer__count {
    color: var(--color-muted);
  }
  .cart-drawer__shipping {
    padding: 14px 24px;
    font-size: 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-bottom: 1px solid var(--color-border);
  }
  .cart-drawer__progress {
    height: 6px;
    border-radius: 999px;
    background: var(--color-border);
    overflow: hidden;
  }
  .cart-drawer__progress span {
    display: block;
    height: 100%;
    background: var(--color-accent);
    border-radius: inherit;
    transition: width 0.4s ease;
  }
  .cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 4px 24px 20px;
  }
  .cart-drawer__items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cart-item {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .cart-item__media {
    position: relative;
    display: block;
    aspect-ratio: 1;
    border-radius: 14px;
    overflow: hidden;
    background: var(--tint-1);
  }
  .cart-item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cart-item__details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .cart-item__title {
    font-weight: 600;
    text-decoration: none;
  }
  .cart-item__variant,
  .cart-item__discount {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .cart-item__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 8px;
  }
  .cart-item__row .quantity {
    height: 44px;
  }
  .cart-item__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-size: 0.9375rem;
  }
  .cart-item__remove {
    align-self: flex-start;
    background: none;
    border: none;
    padding: 6px 0;
    min-height: 32px;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .cart-upsell {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cart-upsell[hidden] {
    display: none;
  }
  .cart-upsell__heading {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .cart-upsell__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cart-drawer__footer {
    padding: 18px 24px calc(20px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cart-drawer__line {
    display: flex;
    justify-content: space-between;
    font-size: 0.9375rem;
  }
  .cart-drawer__total {
    font-weight: 600;
    font-size: 1.0625rem;
  }
  .cart-drawer__note {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .cart-drawer__actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
  }
  .cart-drawer__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
  }
  .cart-drawer__payment-icon {
    width: 34px;
    height: 22px;
  }
  .cart-drawer__empty {
    flex: 1;
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "info": "Your free shipping amount, in your store currency without decimals. 0 hides the progress bar. The bar is only a message: set the real rate in Settings > Shipping and delivery.",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_view_cart",
      "label": "Show View cart button",
      "default": true
    },
    {
      "type": "url",
      "id": "empty_link",
      "label": "Empty cart button link"
    },
    {
      "type": "header",
      "content": "Upsells"
    },
    {
      "type": "checkbox",
      "id": "show_upsell",
      "label": "Suggest products in the cart",
      "default": true
    },
    {
      "type": "text",
      "id": "upsell_heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "select",
      "id": "upsell_source",
      "label": "Products to suggest",
      "options": [
        {
          "value": "complementary",
          "label": "Complementary to the first item"
        },
        {
          "value": "related",
          "label": "Related to the first item"
        },
        {
          "value": "manual",
          "label": "Pick products"
        }
      ],
      "default": "related"
    },
    {
      "type": "product_list",
      "id": "upsell_products",
      "label": "Products",
      "limit": 4,
      "info": "Used with Pick products"
    }
  ]
}
{% endschema %}
