{%- liquid
  assign hosted = section.settings.video
  assign external = section.settings.video_url
  assign poster = section.settings.poster | default: hosted.preview_image | default: collections.all.products.first.featured_image
  assign has_video = false
  if hosted != blank or external != blank
    assign has_video = true
  endif
-%}

<section
  class="section color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
>
  <div class="{% if section.settings.width == 'page' %}page-width{% endif %}">
    <video-feature
      class="video-feature video-feature--{{ section.settings.width }} video-feature--{{ section.settings.ratio }}"
      data-autoplay="{{ section.settings.autoplay }}"
    >
      <div class="video-feature__frame" data-video-target>
        {%- if hosted != blank -%}
          {{
            hosted
            | video_tag: autoplay: section.settings.autoplay, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x', class: 'video-feature__video'
          }}
        {%- elsif poster != blank -%}
          {{
            poster
            | image_url: width: 2000
            | image_tag: widths: '750, 1100, 1500, 2000', sizes: '100vw', loading: 'lazy', alt: '', class: 'video-feature__poster'
          }}
        {%- else -%}
          {% render 'media-placeholder', kind: 'video' %}
        {%- endif -%}
      </div>
      {%- if hosted == blank and external != blank -%}
        <template data-video-embed>
          {%- if external.type == 'youtube' -%}
            <iframe
              class="video-feature__embed"
              src="https://www.youtube.com/embed/{{ external.id }}?autoplay=1&rel=0&playsinline=1"
              title="{{ section.settings.heading | default: 'Video' | escape }}"
              allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
              allowfullscreen
            ></iframe>
          {%- else -%}
            <iframe
              class="video-feature__embed"
              src="https://player.vimeo.com/video/{{ external.id }}?autoplay=1"
              title="{{ section.settings.heading | default: 'Video' | escape }}"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          {%- endif -%}
        </template>
      {%- endif -%}
      <div class="video-feature__overlay" aria-hidden="true"></div>
      <div class="video-feature__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="video-feature__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="video-feature__heading h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="video-feature__link" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label | escape }}
            {% render 'icon', icon: 'arrow-up-right' %}
          </a>
        {%- endif -%}
      </div>
      {%- if has_video -%}
        <button type="button" class="video-feature__toggle" data-video-toggle aria-pressed="false" aria-label="{{ 'sections.video.play' | t }}">
          {% render 'icon', icon: 'play' %}
          {% render 'icon', icon: 'pause' %}
        </button>
      {%- endif -%}
    </video-feature>
  </div>
</section>

{% stylesheet %}
  video-feature {
    display: block;
  }
  .video-feature {
    position: relative;
    overflow: hidden;
    color: #fff;
    aspect-ratio: var(--vf-ratio, 16 / 9);
    background: var(--color-surface);
  }
  .video-feature--cinema {
    --vf-ratio: 21 / 9;
  }
  .video-feature--wide {
    --vf-ratio: 16 / 9;
  }
  .video-feature--tall {
    --vf-ratio: 4 / 5;
  }
  .video-feature--page {
    border-radius: var(--radius-lg);
  }
  .video-feature__frame,
  .video-feature__video,
  .video-feature__poster,
  .video-feature__embed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-feature__video,
  .video-feature__poster {
    object-fit: cover;
  }
  .video-feature__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.1) 55%);
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .video-feature__content {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: clamp(20px, 4vw, 56px);
    transition: opacity 0.4s ease;
  }
  .video-feature__eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--label-ls);
    text-transform: var(--label-case);
  }
  .video-feature__heading {
    max-width: 18ch;
  }
  .video-feature__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: var(--label-ls);
    text-transform: var(--label-case);
    text-decoration: none;
  }
  .video-feature__link:hover {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .video-feature__link .icon {
    width: 16px;
    height: 16px;
  }
  .video-feature__toggle {
    position: absolute;
    top: clamp(16px, 3vw, 32px);
    inset-inline-end: clamp(16px, 3vw, 32px);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.7);
    background: rgb(0 0 0 / 0.2);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background-color 0.2s, scale 0.2s;
  }
  .video-feature__toggle:hover {
    background: rgb(0 0 0 / 0.4);
    scale: 1.05;
  }
  .video-feature__toggle[hidden] {
    display: none;
  }
  .video-feature__toggle .icon {
    width: 20px;
    height: 20px;
    grid-area: 1 / 1;
  }
  .video-feature__toggle .icon--pause,
  .video-feature.is-playing .video-feature__toggle .icon--play {
    display: none;
  }
  .video-feature.is-playing .video-feature__toggle .icon--pause {
    display: block;
  }
  .video-feature.is-embedded .video-feature__overlay,
  .video-feature.is-embedded .video-feature__content {
    opacity: 0;
    pointer-events: none;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .video-feature {
        animation: video-grow linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
      @keyframes video-grow {
        from {
          scale: 0.86;
          border-radius: 40px;
        }
        to {
          scale: 1;
        }
      }
    }
  }
  @media (max-width: 749px) {
    .video-feature--cinema,
    .video-feature--wide {
      --vf-ratio: 4 / 5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "video-feature-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "video", "id": "video", "label": "Video", "info": "Upload in Content > Files. It plays muted on a loop." },
    { "type": "video_url", "id": "video_url", "label": "Or YouTube or Vimeo link", "accept": ["youtube", "vimeo"], "info": "Plays with sound when the shopper presses play" },
    { "type": "image_picker", "id": "poster", "label": "Cover image", "info": "Shown before the video plays" },
    { "type": "checkbox", "id": "autoplay", "label": "Play uploaded video automatically", "default": true },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "page", "label": "Page width" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Shape on desktop",
      "options": [
        { "value": "cinema", "label": "Cinema (21:9)" },
        { "value": "wide", "label": "Wide (16:9)" },
        { "value": "tall", "label": "Tall (4:5)" }
      ],
      "default": "cinema"
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The campaign" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In motion" },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Shop the film" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "header", "content": "Spacing" },
    { "type": "select", "id": "padding_top", "label": "Top spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" },
    { "type": "select", "id": "padding_bottom", "label": "Bottom spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "none" }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}
