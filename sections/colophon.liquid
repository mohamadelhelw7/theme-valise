{%- assign form_id = 'ColophonSignup-' | append: section.id -%}

<footer class="colophon color-{{ section.settings.color_scheme }}">
  <div class="page-width colophon__inner">
    {%- if section.settings.show_signup -%}
      {%- form 'customer', id: form_id, class: 'colophon__signup', data-signup-id: form_id -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <p class="colophon__success" role="status" data-signup-success hidden>{{ 'newsletter.success' | t }}</p>
        <div class="colophon__signup-row" data-signup-fields>
          <label class="colophon__signup-label" for="{{ form_id }}-email">{{ section.settings.signup_label | escape }}</label>
          <input id="{{ form_id }}-email" class="colophon__input" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required>
          <button type="submit" class="colophon__submit">{{ 'newsletter.button' | t }}</button>
        </div>
      {%- endform -%}
    {%- endif -%}

    <div class="colophon__columns">
      <div class="colophon__brand">
        <span class="colophon__wordmark">{{ section.settings.wordmark | default: shop.name | escape }}</span>
        {%- if section.settings.text != blank -%}
          <div class="colophon__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
      {%- for menu in (1..2) -%}
        {%- liquid
          if forloop.first
            assign col_menu = section.settings.menu_1
            assign col_heading = section.settings.menu_1_heading
          else
            assign col_menu = section.settings.menu_2
            assign col_heading = section.settings.menu_2_heading
          endif
        -%}
        {%- if col_menu != blank -%}
          <nav class="colophon__menu" aria-label="{{ col_heading | default: col_menu.title | escape }}">
            <span class="colophon__heading">{{ col_heading | default: col_menu.title | escape }}</span>
            <ul role="list">
              {%- for link in col_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="colophon__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
      {%- if section.settings.show_social -%}
        {% render 'social-icons' %}
      {%- endif -%}
      {%- if section.settings.show_localization -%}
        {% render 'localization-form', id_prefix: 'Colophon', show_language: true, show_country: true %}
      {%- endif -%}
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="colophon__payments" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'colophon__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .colophon {
    padding-block: clamp(48px, 8vw, 112px) 28px;
  }
  .colophon__inner {
    display: grid;
    gap: clamp(40px, 6vw, 88px);
  }
  .colophon__signup-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    border-bottom: 1px solid currentColor;
  }
  .colophon__signup-label,
  .colophon__submit,
  .colophon__heading {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 1.0625rem;
  }
  .colophon__input {
    min-width: 0;
    min-height: 56px;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    font-style: italic;
  }
  .colophon__input:focus {
    outline: none;
  }
  .colophon__submit {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .colophon__success {
    font-family: var(--font-heading);
    font-size: 1.5rem;
  }
  .colophon__columns {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
    gap: 32px;
  }
  .colophon__brand {
    display: grid;
    gap: 14px;
    align-content: start;
    max-width: 30em;
  }
  .colophon__wordmark {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
  .colophon__text {
    color: var(--color-muted);
  }
  .colophon__menu {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .colophon__heading {
    color: var(--color-muted);
  }
  .colophon__menu ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .colophon__menu a {
    color: inherit;
    text-decoration: none;
  }
  .colophon__menu a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .colophon__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .colophon__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .colophon__payment-icon {
    width: 34px;
    height: 22px;
  }
  @media (max-width: 749px) {
    .colophon__signup-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .colophon__signup-label {
      grid-column: 1 / -1;
      padding-top: 6px;
    }
    .colophon__columns {
      grid-template-columns: 1fr 1fr;
    }
    .colophon__brand {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Colophon",
  "tag": "div",
  "class": "footer-section colophon-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_signup", "label": "Show email signup", "default": true },
    { "type": "text", "id": "signup_label", "label": "Signup label", "default": "News of new rooms" },
    { "type": "text", "id": "wordmark", "label": "Text logo", "info": "Defaults to store name" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Bags shown one at a time, like objects in a gallery.</p>" },
    { "type": "link_list", "id": "menu_1", "label": "First menu", "default": "main-menu" },
    { "type": "text", "id": "menu_1_heading", "label": "First menu heading", "default": "Collection" },
    { "type": "link_list", "id": "menu_2", "label": "Second menu", "default": "footer" },
    { "type": "text", "id": "menu_2_heading", "label": "Second menu heading", "default": "Visit" },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true },
    { "type": "checkbox", "id": "show_localization", "label": "Show language and country", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ]
}
{% endschema %}
