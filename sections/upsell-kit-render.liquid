{%- comment -%}
  Renders suggestions for the Pair it with and Product add-ons blocks through the product
  recommendations endpoint (section_id=upsell-kit-render). Each block copies the list for its layout.
  A new store has no recommendations yet, so it then falls back to other products from the
  product's collection, or from the whole store. Products in the cart and sold out products are left out.
{%- endcomment -%}

{%- liquid
  assign in_cart = ','
  for item in cart.items
    assign in_cart = in_cart | append: item.product_id | append: ','
  endfor
  assign rec_list = recommendations.products
  if recommendations.products_count == 0
    assign rec_pool = collections.all
    for rec_collection in product.collections
      if rec_collection.products_count > 3
        assign rec_pool = rec_collection
        break
      endif
    endfor
    assign rec_list = rec_pool.products
  endif
-%}

<div data-upsell-kit-results>
  {%- if recommendations.performed? -%}
    {%- for kit in (1..6) -%}
      {%- liquid
        case kit
          when 1
            assign kit_name = 'pair-row'
          when 2
            assign kit_name = 'pair-card'
          when 3
            assign kit_name = 'pair-quick'
          when 4
            assign kit_name = 'addon-checks'
          when 5
            assign kit_name = 'addon-tiles'
          else
            assign kit_name = 'addon-toggles'
        endcase
        assign kit_layout = kit_name | split: '-' | last
        assign shown = 0
      -%}
      <div data-kit="{{ kit_name }}">
        {%- for rec in rec_list -%}
          {%- assign needle = ',' | append: rec.id | append: ',' -%}
          {%- if in_cart contains needle or rec.available == false or rec.id == product.id -%}
            {%- continue -%}
          {%- endif -%}
          {%- if kit < 4 -%}
            {% render 'upsell-kit-pair', product: rec, layout: kit_layout %}
          {%- else -%}
            {% render 'upsell-kit-addon', product: rec, layout: kit_layout %}
          {%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- if shown >= 8 -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Upsell kit results",
  "tag": "div",
  "settings": []
}
{% endschema %}
