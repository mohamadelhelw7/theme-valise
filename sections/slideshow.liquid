<slide-show
  class="slideshow slideshow--{{ section.settings.height }} slideshow--{{ section.settings.transition }} slideshow--text-{{ section.settings.content_style }} slideshow--align-{{ section.settings.text_position }} slideshow--dots-{{ section.settings.dots }} color-{{ section.settings.color_scheme }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.interval | times: 1000 }}"
  style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }};"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  data-no-reveal
>
  <div class="slideshow__slides">
    {% content_for 'blocks' %}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="slideshow__controls">
      {%- if section.settings.dots == 'ring' -%}
        <button type="button" class="slideshow__ring" data-slide-next data-slide-ring aria-label="{{ 'sections.slideshow.next' | t }}">
          <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <circle class="slideshow__ring-track" cx="24" cy="24" r="22"></circle>
            <circle class="slideshow__ring-bar" cx="24" cy="24" r="22" pathLength="100"></circle>
          </svg>
          <span class="slideshow__count" aria-hidden="true">
            <span data-slide-current>1</span><span class="slideshow__count-total">/{{ section.blocks.size }}</span>
          </span>
        </button>
      {%- else -%}
        <div class="slideshow__dots">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="slideshow__dot"
              data-slide-dot
              aria-label="{{ 'sections.slideshow.go_to' | t: number: forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              <span></span>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <button type="button" class="slideshow__pause" data-slide-pause hidden aria-label="{{ 'general.slider.pause' | t }}">
        {% render 'icon', icon: 'pause' %}
        {% render 'icon', icon: 'play' %}
      </button>
    </div>
  {%- endif -%}
</slide-show>

{% stylesheet %}
  .slideshow {
    position: relative;
    display: block;
    overflow: hidden;
    isolation: isolate;
  }
  .slideshow--small {
    --slideshow-height: 62svh;
  }
  .slideshow--medium {
    --slideshow-height: 82svh;
  }
  .slideshow--full {
    --slideshow-height: 100svh;
  }
  .slideshow__slides {
    position: relative;
    height: var(--slideshow-height);
    min-height: 480px;
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1s ease, visibility 0s linear 1s;
  }
  .slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
    transition: opacity 1s ease;
  }
  .slide.is-leaving {
    z-index: 1;
  }

  /* Vertical blinds */
  @property --blinds {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 100%;
  }
  @keyframes slide-blinds {
    from {
      --blinds: 0%;
    }
    to {
      --blinds: 100%;
    }
  }
  .slideshow--blinds .slide.is-leaving {
    opacity: 1;
    visibility: visible;
    transition: none;
  }
  .slideshow--blinds .slide.is-active {
    transition: none;
    -webkit-mask-image: linear-gradient(90deg, #000 var(--blinds), transparent var(--blinds));
    mask-image: linear-gradient(90deg, #000 var(--blinds), transparent var(--blinds));
    -webkit-mask-size: 12.5% 100%;
    mask-size: 12.5% 100%;
    animation: slide-blinds 1.3s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .slideshow--blinds .slide.is-active.is-first-load {
    animation: none;
    -webkit-mask-image: none;
    mask-image: none;
  }

  /* Zoom reveal: the old slide dips to dark while the new photo settles from a close zoom */
  .slideshow--reveal .slideshow__slides {
    background: #0b0b0b;
  }
  .slideshow--reveal .slide {
    transition: opacity 1.3s cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0s linear 1.3s;
  }
  .slideshow--reveal .slide.is-active {
    transition: opacity 1.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .slideshow--reveal .slide.is-active .slide__media {
    animation: slide-reveal 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .slideshow--reveal .slide.is-active .slide__half:first-child .slide__image {
    animation: slide-half-down 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) both, slide-zoom 9s ease-out both;
  }
  .slideshow--reveal .slide.is-active .slide__half:last-child .slide__image {
    animation: slide-half-up 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) both, slide-zoom 9s ease-out both;
  }
  @keyframes slide-reveal {
    from {
      scale: 1.22;
    }
    to {
      scale: 1;
    }
  }
  @keyframes slide-half-down {
    from {
      translate: 0 -4%;
    }
    to {
      translate: none;
    }
  }
  @keyframes slide-half-up {
    from {
      translate: 0 4%;
    }
    to {
      translate: none;
    }
  }

  .slide__media,
  .slide__media picture,
  .slide__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .slide__image {
    object-fit: cover;
  }
  .slide.is-active .slide__image {
    animation: slide-zoom 9s ease-out both;
  }
  @keyframes slide-zoom {
    from {
      scale: 1.08;
    }
    to {
      scale: 1;
    }
  }
  .slide__media--split {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .slide__half {
    position: relative;
    overflow: hidden;
  }
  .slide__half .media-placeholder {
    position: absolute;
  }
  .slide__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / calc(var(--overlay) + 0.2)),
      rgb(0 0 0 / var(--overlay)) 55%,
      rgb(0 0 0 / calc(var(--overlay) * 0.6))
    );
  }
  .slideshow--text-framed .slide__overlay {
    background: rgb(0 0 0 / var(--overlay));
  }
  .slide:not(:has(.slide__image)) .slide__overlay {
    display: none;
  }
  .slide__inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    text-align: center;
    gap: 28px;
    padding-top: calc(var(--header-overlap, 0px) + 28px);
    padding-bottom: 64px;
  }
  .slideshow--align-start .slide__inner,
  .slideshow--align-start .slide__content {
    align-items: flex-start;
    text-align: start;
  }
  .slideshow--align-middle .slide__inner {
    justify-content: center;
    padding-bottom: 88px;
  }
  .slide__inset-wrap {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    align-self: center;
  }
  .slideshow--align-middle .slide__inset-wrap {
    flex: 0 1 auto;
  }
  .slide__inset {
    position: relative;
    width: clamp(170px, 22vw, 340px);
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 40px 70px -40px rgb(0 0 0 / 0.7);
  }
  .slide__inset img,
  .slide__inset video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .slide.is-active .slide__inset img {
    animation: slide-zoom 7s ease-out both;
  }
  .slide__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: var(--label-ls);
    text-transform: var(--label-case);
  }
  .slide__link:hover {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .slide__link .icon {
    width: 16px;
    height: 16px;
  }
  .slide__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 820px;
  }
  .slide__eyebrow {
    color: inherit;
  }
  .slide__heading {
    font-size: calc(clamp(2rem, 4.2vw, 3.75rem) * var(--heading-scale));
  }
  .slide__text {
    max-width: 620px;
    font-size: 0.9375rem;
    opacity: 0.88;
  }
  .slide__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }
  .slideshow--align-start .slide__buttons {
    justify-content: flex-start;
  }
  .slide.is-active .slide__content > *,
  .slide.is-active .slide__link {
    animation: slide-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: 0.45s;
  }
  .slide.is-active .slide__content > :nth-child(2) {
    animation-delay: 0.55s;
  }
  .slide.is-active .slide__content > :nth-child(3) {
    animation-delay: 0.65s;
  }
  .slide.is-active .slide__content > :nth-child(4) {
    animation-delay: 0.75s;
  }
  .slide.is-active .slide__content > :nth-child(5) {
    animation-delay: 0.85s;
  }
  @keyframes slide-rise {
    from {
      opacity: 0;
      translate: 0 24px;
    }
    to {
      opacity: 1;
      translate: none;
    }
  }

  /* Text in a thin frame that draws itself */
  .slideshow--text-framed .slide__content {
    max-width: min(560px, 100%);
    padding: clamp(32px, 4vw, 56px) clamp(28px, 6vw, 80px);
    gap: 16px;
  }
  .slideshow--text-framed .slide__heading {
    font-size: calc(clamp(1.75rem, 3.4vw, 3rem) * var(--heading-scale));
  }
  .slide__frame {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .slide__frame i {
    position: absolute;
    background: currentColor;
    opacity: 0.75;
  }
  .slide__frame i:nth-child(1) {
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    transform-origin: left center;
  }
  .slide__frame i:nth-child(2) {
    top: 0;
    right: 0;
    bottom: 0;
    width: 1px;
    transform-origin: center top;
  }
  .slide__frame i:nth-child(3) {
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    transform-origin: right center;
  }
  .slide__frame i:nth-child(4) {
    top: 0;
    left: 0;
    bottom: 0;
    width: 1px;
    transform-origin: center bottom;
  }
  [dir='rtl'] .slide__frame i:nth-child(1) {
    transform-origin: right center;
  }
  [dir='rtl'] .slide__frame i:nth-child(3) {
    transform-origin: left center;
  }
  .slideshow--text-framed .slide.is-active .slide__content > .slide__frame {
    animation: none;
  }
  .slide.is-active .slide__frame i:nth-child(odd) {
    animation: frame-x 0.7s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .slide.is-active .slide__frame i:nth-child(even) {
    animation: frame-y 0.7s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .slide.is-active .slide__frame i:nth-child(1) {
    animation-delay: 0.35s;
  }
  .slide.is-active .slide__frame i:nth-child(2) {
    animation-delay: 0.75s;
  }
  .slide.is-active .slide__frame i:nth-child(3) {
    animation-delay: 1.15s;
  }
  .slide.is-active .slide__frame i:nth-child(4) {
    animation-delay: 1.55s;
  }
  @keyframes frame-x {
    from {
      scale: 0 1;
    }
    to {
      scale: 1 1;
    }
  }
  @keyframes frame-y {
    from {
      scale: 1 0;
    }
    to {
      scale: 1 1;
    }
  }
  .slideshow--text-framed .slide.is-active .slide__heading {
    animation: heading-open 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) 0.6s both;
  }
  @keyframes heading-open {
    from {
      opacity: 0;
      clip-path: inset(0 50%);
      scale: 1.06;
    }
    to {
      opacity: 1;
      clip-path: inset(0 -1em);
      scale: 1;
    }
  }

  /* Controls */
  .slideshow__controls {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .slideshow--dots-side .slideshow__controls {
    inset-inline-end: var(--gutter);
    top: 50%;
    translate: 0 -50%;
    flex-direction: column;
  }
  .slideshow--dots-bottom .slideshow__controls,
  .slideshow--dots-ring .slideshow__controls {
    bottom: 18px;
    inset-inline: 0;
    justify-content: center;
  }
  .slideshow--dots-ring .slideshow__controls {
    bottom: clamp(16px, 3vw, 28px);
    flex-direction: row-reverse;
  }
  .slideshow__dots {
    display: flex;
    gap: 2px;
  }
  .slideshow--dots-side .slideshow__dots {
    flex-direction: column;
  }
  .slideshow__dot {
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .slideshow__dot span {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    border: 1px solid currentColor;
    transition: width 0.3s ease, height 0.3s ease, background-color 0.3s ease;
  }
  .slideshow__dot[aria-current='true'] span {
    background: currentColor;
  }
  .slideshow--dots-side .slideshow__dot[aria-current='true'] span {
    height: 22px;
  }
  .slideshow--dots-bottom .slideshow__dot[aria-current='true'] span {
    width: 22px;
  }
  .slideshow__ring {
    position: relative;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: inherit;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .slideshow__ring svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    rotate: -90deg;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }
  .slideshow__ring-track {
    opacity: 0.35;
  }
  .slideshow__ring-bar {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  .slideshow__ring.is-ticking .slideshow__ring-bar {
    animation: ring-fill var(--slide-interval, 6s) linear both;
  }
  @keyframes ring-fill {
    to {
      stroke-dashoffset: 0;
    }
  }
  .slideshow__count {
    font-family: var(--font-label);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }
  .slideshow__count-total {
    opacity: 0.6;
  }
  .slideshow__pause {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: none;
    color: inherit;
    display: grid;
    place-items: center;
    cursor: pointer;
    padding: 0;
  }
  .slideshow__pause[hidden] {
    display: none;
  }
  .slideshow__pause .icon {
    width: 14px;
    height: 14px;
    grid-area: 1 / 1;
  }
  .slideshow__pause .icon--play,
  .slideshow__pause.is-paused .icon--pause {
    display: none;
  }
  .slideshow__pause.is-paused .icon--play {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .slide__frame i,
    .slideshow--text-framed .slide.is-active .slide__heading,
    .slideshow--reveal .slide.is-active .slide__media,
    .slideshow--reveal .slide.is-active .slide__image {
      animation: none !important;
    }
    .slideshow__ring-bar {
      stroke-dashoffset: 0;
    }
  }
  @media (max-width: 749px) {
    .slideshow__slides {
      min-height: 520px;
    }
    .slide__inner {
      padding-bottom: 56px;
      gap: 20px;
    }
    .slideshow--align-middle .slide__inner {
      padding-bottom: 84px;
    }
    .slide__inset {
      width: 52vw;
    }
    .slide__media--split {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
    }
    .slideshow--dots-side .slideshow__controls {
      top: auto;
      bottom: 16px;
      translate: none;
      inset-inline: 0;
      flex-direction: row;
      justify-content: center;
    }
    .slideshow--dots-side .slideshow__dots {
      flex-direction: row;
    }
    .slideshow--dots-side .slideshow__dot[aria-current='true'] span {
      height: 8px;
      width: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "class": "slideshow-section",
  "max_blocks": 5,
  "blocks": [{ "type": "_slide" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "transition",
      "label": "Slide change",
      "options": [
        { "value": "reveal", "label": "Zoom reveal" },
        { "value": "fade", "label": "Fade" },
        { "value": "blinds", "label": "Vertical blinds" }
      ],
      "default": "reveal"
    },
    {
      "type": "select",
      "id": "content_style",
      "label": "Text style",
      "options": [
        { "value": "framed", "label": "In a thin frame" },
        { "value": "plain", "label": "Plain" }
      ],
      "default": "framed",
      "info": "The frame draws itself around the text when a slide appears."
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "middle", "label": "Middle" },
        { "value": "center", "label": "Bottom center" },
        { "value": "start", "label": "Bottom start" }
      ],
      "default": "middle"
    },
    {
      "type": "select",
      "id": "dots",
      "label": "Slide controls",
      "options": [
        { "value": "ring", "label": "Next button with a timer ring" },
        { "value": "side", "label": "Dots at the side" },
        { "value": "bottom", "label": "Dots at the bottom" }
      ],
      "default": "ring"
    },
    { "type": "range", "id": "overlay", "label": "Image darkening", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 20 },
    { "type": "checkbox", "id": "autoplay", "label": "Change slides automatically", "default": true },
    { "type": "range", "id": "interval", "label": "Time per slide", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 7 }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        { "type": "_slide", "settings": { "eyebrow": "The new collection", "heading": "Made to be carried", "text": "Bags for every day and every evening.", "show_inset": false } },
        { "type": "_slide", "settings": { "layout": "split", "eyebrow": "Small leather goods", "heading": "The details", "text": "Wallets, card holders and pouches.", "show_inset": false } },
        { "type": "_slide", "settings": { "eyebrow": "Everyday carry", "heading": "Day to night", "text": "One bag, from the morning to the last dinner.", "show_inset": false } }
      ]
    }
  ]
}
{% endschema %}
