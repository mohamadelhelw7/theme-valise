{%- liquid
  assign heading_id = 'ReelsHeading-' | append: section.id
-%}

<section
  class="section reels color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
  {% if section.settings.heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <card-slider class="page-width reels__inner">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      heading_id: heading_id,
      description: section.settings.description,
      alignment: section.settings.header_alignment,
      slider: true
    %}
    <reel-row class="reels__row">
      <ul class="slider-track reels__track" role="list" data-slider-track style="--slider-cols: {{ section.settings.columns }};">
        {% content_for 'blocks' %}
      </ul>
    </reel-row>
  </card-slider>
</section>

{% stylesheet %}
  .reels__track {
    padding-bottom: 4px;
  }
  .reel {
    min-width: 0;
  }
  .reel__media {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .reel__media video,
  .reel__media img,
  .reel__media .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .reel__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), transparent 42%);
  }
  .reel__toggle {
    position: absolute;
    top: 12px;
    inset-inline-end: 12px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.5);
    color: #fff;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: background-color 0.2s ease, scale 0.2s ease;
  }
  .reel__toggle:hover {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .reel__toggle .icon {
    width: 18px;
    height: 18px;
  }
  .reel__icon-pause,
  .reel.has-sound.is-playing .reel__icon-play {
    display: none;
  }
  .reel.has-sound.is-playing .reel__icon-pause {
    display: block;
  }
  .reel__caption {
    position: absolute;
    inset-inline: 14px;
    bottom: 76px;
    z-index: 1;
    margin: 0;
    color: #fff;
    font: 700 0.75rem/1.3 var(--font-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .reel__media:not(:has(.reel__product)) .reel__caption {
    bottom: 16px;
  }
  .reel__product {
    position: absolute;
    inset-inline: 10px;
    bottom: 10px;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px;
    padding-inline-end: 12px;
    border-radius: var(--radius-md, 12px);
    background: var(--color-bg);
    color: var(--color-text);
    text-decoration: none;
    transition: translate 0.25s ease;
  }
  .reel__product:hover {
    translate: 0 -3px;
  }
  .reel__product-media {
    flex: none;
    width: 44px;
    height: 44px;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }
  .reel__product-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .reel__product-text {
    display: grid;
    flex: 1;
    min-width: 0;
    gap: 2px;
  }
  .reel__product-title {
    overflow: hidden;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .reel__product-price {
    font: 700 0.75rem/1 var(--font-label);
  }
  .reel__product-icon {
    flex: none;
    width: 16px;
    height: 16px;
  }
  @media (max-width: 989px) {
    .reels__track {
      grid-auto-columns: calc((100% - var(--grid-gap)) / 2.4);
    }
  }
  @media (max-width: 749px) {
    .reels__track {
      grid-auto-columns: 62%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reels",
  "tag": "div",
  "class": "reels-section",
  "max_blocks": 12,
  "blocks": [{ "type": "_reel" }],
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Seen on you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In motion" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Press play to see the bags in motion.</p>" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header layout",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "split", "label": "Split" }
      ],
      "default": "start"
    },
    { "type": "range", "id": "columns", "label": "Reels per row on desktop", "min": 3, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "auto_products", "label": "Fill empty product slots from your store", "default": true },
    { "type": "color_scheme", "id": "chip_scheme", "label": "Product chip color scheme", "default": "scheme-3" },
    { "type": "header", "content": "Spacing" },
    { "type": "select", "id": "padding_top", "label": "Top spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" },
    { "type": "select", "id": "padding_bottom", "label": "Bottom spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "none" }
  ],
  "presets": [
    {
      "name": "Reels",
      "blocks": [
        { "type": "_reel" },
        { "type": "_reel" },
        { "type": "_reel" },
        { "type": "_reel" },
        { "type": "_reel" }
      ]
    }
  ]
}
{% endschema %}
