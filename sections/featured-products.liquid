{%- liquid
  assign limit = section.settings.products_to_show
  assign tab_count = section.blocks.size
  assign heading_id = 'FeaturedHeading-' | append: section.id
  assign is_slider = false
  if section.settings.layout == 'slider'
    assign is_slider = true
  endif
-%}

{%- capture tabs_markup -%}
  {%- if tab_count > 1 -%}
    <tab-list class="pill-tabs pill-tabs--{{ section.settings.tab_style }}" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tab_label = block.settings.label | default: block.settings.collection.title
          assign tab_image = block.settings.image
          if tab_image == blank
            assign tab_image = block.settings.collection.featured_image | default: block.settings.collection.products.first.featured_image
          endif
          if tab_image == blank
            assign tab_image = collections.all.products[forloop.index0].featured_image
          endif
        -%}
        <button
          type="button"
          role="tab"
          class="pill-tabs__tab"
          id="Tab-{{ block.id }}"
          aria-controls="Panel-{{ block.id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          {% if section.settings.tab_style == 'images' %}
            title="{{ tab_label | escape }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if section.settings.tab_style == 'images' -%}
            <span class="pill-tabs__image">
              {%- if tab_image != blank -%}
                {{ tab_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 80, height: 80 }}
              {%- endif -%}
            </span>
            <span class="pill-tabs__image-label">{{ tab_label | escape }}</span>
          {%- else -%}
            {{- tab_label | escape -}}
          {%- endif -%}
        </button>
      {%- endfor -%}
    </tab-list>
  {%- endif -%}
{%- endcapture -%}

<section
  class="section color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
  aria-labelledby="FeaturedHeading-{{ section.id }}"
>
  <card-slider class="page-width featured-products featured-products--tabs-{{ section.settings.tab_style }}">
    {%- liquid
      assign header_link = section.settings.view_all_link
      if section.settings.view_all_position == 'below'
        assign header_link = blank
      endif
    -%}
    {%- if section.settings.tab_style == 'words' and tab_count > 1 -%}
      <div class="featured-products__words">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 id="{{ heading_id }}" class="visually-hidden">{{ section.settings.heading | default: section.settings.eyebrow | escape }}</h2>
        {{ tabs_markup }}
        {%- if is_slider -%}
          <div class="featured-products__words-arrows">{% render 'slider-buttons' %}</div>
        {%- endif -%}
      </div>
    {%- else -%}
      {% render 'section-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        heading_id: heading_id,
        description: section.settings.description,
        alignment: section.settings.header_alignment,
        link_url: header_link,
        link_label: section.settings.view_all_label,
        slider: is_slider,
        start: tabs_markup
      %}
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- liquid
        assign tab_collection = block.settings.collection | default: collections.all
        assign tab_products = tab_collection.products
        if block.settings.show == 'newest'
          assign tab_products = tab_products | sort: 'created_at' | reverse
        endif
        assign shown = 0
      -%}
      {%- capture tab_cards -%}
        {%- for product in tab_products -%}
          {%- if block.settings.show == 'on_sale' -%}
            {%- unless product.compare_at_price > product.price -%}{%- continue -%}{%- endunless -%}
          {%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <li>{% render 'product-card', product: product, index: shown %}</li>
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if shown == 0 and tab_collection.products_count > 0 -%}
        {%- capture tab_cards -%}
          {%- for product in tab_collection.products limit: limit -%}
            <li>{% render 'product-card', product: product, index: forloop.index %}</li>
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign shown = 1 -%}
      {%- endif -%}
      <div
        id="Panel-{{ block.id }}"
        class="featured-products__panel"
        {% if tab_count > 1 %}
          role="tabpanel" aria-labelledby="Tab-{{ block.id }}" tabindex="0"
        {% endif %}
        {% unless forloop.first %}
          hidden
        {% endunless %}
      >
        <ul
          class="{% if is_slider %}slider-track slider-track--products{% else %}product-grid{% if section.settings.mobile_layout == 'swipe' %} product-grid--swipe{% endif %}{% endif %}"
          role="list"
          style="--cols-desktop: {{ section.settings.columns_desktop }}; --cols-mobile: {{ section.settings.columns_mobile }}; --slider-cols: {{ section.settings.columns_desktop }};"
          {% if is_slider %}
            data-slider-track
          {% endif %}
        >
          {%- if shown > 0 -%}
            {{ tab_cards }}
          {%- else -%}
            {%- for i in (1..limit) -%}
              <li>{% render 'product-card', product: blank, index: i %}</li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    {%- endfor -%}
    {%- if section.settings.view_all_position == 'below' and section.settings.view_all_link != blank and section.settings.view_all_label != blank -%}
      <div class="featured-products__more">
        <a href="{{ section.settings.view_all_link }}" class="button button--primary">{{ section.settings.view_all_label | escape }}</a>
      </div>
    {%- endif -%}
  </card-slider>
</section>

{% stylesheet %}
  .pill-tabs--images {
    display: inline-flex;
    gap: 8px;
    background: none;
    padding: 0;
    border-radius: 0;
  }
  .pill-tabs--images .pill-tabs__tab {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-height: 0;
    padding: 6px 6px 8px;
    border-radius: 0;
    background: var(--color-surface);
    box-shadow: inset 0 -2px 0 transparent;
    transition: box-shadow 0.2s;
  }
  .pill-tabs--images .pill-tabs__tab[aria-selected='true'] {
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }
  .pill-tabs__image {
    width: 64px;
    height: 48px;
    display: block;
    overflow: hidden;
  }
  .pill-tabs__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .pill-tabs__image-label {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: var(--label-ls);
    text-transform: var(--label-case);
    max-width: 76px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pill-tabs {
    display: inline-flex;
    flex-wrap: wrap;
    background: var(--color-surface);
    border-radius: 999px;
    padding: 4px;
    gap: 4px;
    max-width: 100%;
  }
  .pill-tabs__tab {
    border: none;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    min-height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    background: transparent;
    color: var(--color-body);
    transition: background-color 0.2s, color 0.2s;
  }
  .pill-tabs__tab:hover {
    color: var(--color-text);
  }
  .pill-tabs__tab[aria-selected='true'] {
    background: var(--color-text);
    color: var(--color-surface);
  }
  .featured-products__panel:focus-visible {
    outline-offset: 8px;
    border-radius: var(--radius-md);
  }
  @media (max-width: 749px) {
    .pill-tabs__tab {
      padding: 0 16px;
    }
  }
  .featured-products__words {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-bottom: clamp(28px, 4vw, 48px);
    text-align: center;
  }
  .featured-products__words-arrows {
    position: absolute;
    inset-inline-end: 0;
    bottom: 0;
  }
  .pill-tabs--words {
    background: none;
    padding: 0;
    border-radius: 0;
    gap: 8px clamp(24px, 4vw, 56px);
    justify-content: center;
  }
  .pill-tabs--words .pill-tabs__tab {
    padding: 0 0 6px;
    min-height: 44px;
    border-radius: 0;
    background: none;
    color: var(--color-muted);
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: calc(clamp(1.375rem, 2.6vw, 2.25rem) * var(--heading-scale));
    letter-spacing: var(--heading-ls);
    text-transform: var(--heading-case);
    line-height: 1.1;
    box-shadow: inset 0 -1px 0 transparent;
    transition: color 0.3s, box-shadow 0.3s;
  }
  .pill-tabs--words .pill-tabs__tab:hover {
    color: var(--color-text);
  }
  .pill-tabs--words .pill-tabs__tab[aria-selected='true'] {
    background: none;
    color: var(--color-text);
    box-shadow: inset 0 -1px 0 currentColor;
  }
  .featured-products__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(32px, 4vw, 56px);
  }
  @media (max-width: 749px) {
    .featured-products__words-arrows {
      display: none;
    }
  }
  .pill-tabs--underline {
    background: none;
    padding: 0;
    border-radius: 0;
    gap: 4px 28px;
  }
  .pill-tabs--underline .pill-tabs__tab {
    padding: 0;
    min-height: 40px;
    border-radius: 0;
    background: none;
    color: var(--color-muted);
    font-weight: 500;
    letter-spacing: calc(var(--label-ls) * 0.6);
    text-transform: var(--label-case);
    font-size: 0.8125rem;
    box-shadow: inset 0 -1px 0 transparent;
    transition: color 0.2s, box-shadow 0.2s;
  }
  .pill-tabs--underline .pill-tabs__tab[aria-selected='true'] {
    background: none;
    color: var(--color-text);
    box-shadow: inset 0 -1px 0 currentColor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured products",
  "tag": "div",
  "class": "featured-products-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the collection"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all products"
    },
    {
      "type": "select",
      "id": "view_all_position",
      "label": "View all link position",
      "options": [
        {
          "value": "header",
          "label": "In the header"
        },
        {
          "value": "below",
          "label": "Button under the products"
        }
      ],
      "default": "header"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading layout",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "split",
          "label": "Split with accent line"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "tab_style",
      "label": "Tab style",
      "options": [
        {
          "value": "words",
          "label": "Large words"
        },
        {
          "value": "underline",
          "label": "Underlined text"
        },
        {
          "value": "pills",
          "label": "Pills"
        },
        {
          "value": "images",
          "label": "Photos"
        }
      ],
      "default": "underline",
      "info": "Large words replace the heading when there are two or more tabs"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider with arrows"
        }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products per tab",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Layout on mobile",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "swipe",
          "label": "Swipe row"
        }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top spacing",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "info": "Defaults to the collection title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Leave empty to use all products"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tab photo",
          "info": "Used by the Photos tab style. Defaults to the collection image."
        },
        {
          "type": "select",
          "id": "show",
          "label": "Show",
          "options": [
            {
              "value": "all",
              "label": "All products in order"
            },
            {
              "value": "newest",
              "label": "Newest first"
            },
            {
              "value": "on_sale",
              "label": "Only products on sale"
            }
          ],
          "default": "all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "label": "New in",
            "show": "newest"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "All bags"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "On sale",
            "show": "on_sale"
          }
        }
      ]
    }
  ]
}
{% endschema %}
