<section
  class="section color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});"
>
  <div class="page-width">
    <div class="social-gallery__header">
      {%- if section.settings.show_icon -%}
        {% render 'icon', icon: 'instagram', class: 'social-gallery__icon' %}
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.handle != blank -%}
        {%- if section.settings.link != blank -%}
          <a class="social-gallery__handle" href="{{ section.settings.link }}" target="_blank" rel="noopener">{{ section.settings.handle | escape }}</a>
        {%- else -%}
          <span class="social-gallery__handle">{{ section.settings.handle | escape }}</span>
        {%- endif -%}
      {%- endif -%}
    </div>
    <ul class="social-gallery" role="list" style="--gallery-cols: {{ section.settings.columns }};">
      {% content_for 'blocks' %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .social-gallery__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    margin-bottom: 32px;
  }
  .social-gallery__icon {
    width: 28px;
    height: 28px;
    color: var(--color-accent);
  }
  .social-gallery__handle {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: var(--label-ls);
    text-transform: var(--label-case);
    color: var(--color-muted);
  }
  .social-gallery {
    display: grid;
    grid-template-columns: repeat(var(--gallery-cols), minmax(0, 1fr));
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .social-gallery__item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--tint-1);
  }
  .social-gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s ease;
  }
  .social-gallery__link {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgb(0 0 0 / 0.32);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .social-gallery__link .icon {
    width: 28px;
    height: 28px;
  }
  .social-gallery__item:hover img {
    scale: 1.06;
  }
  .social-gallery__item:hover .social-gallery__link,
  .social-gallery__link:focus-visible {
    opacity: 1;
  }
  @media (max-width: 749px) {
    .social-gallery {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .social-gallery__item {
      flex: 0 0 42%;
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Social gallery",
  "tag": "div",
  "class": "social-gallery-section",
  "max_blocks": 10,
  "blocks": [{ "type": "_gallery-image" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_icon", "label": "Show Instagram icon", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow our journey" },
    { "type": "text", "id": "handle", "label": "Handle", "info": "For example @yourstore" },
    { "type": "url", "id": "link", "label": "Profile link" },
    { "type": "range", "id": "columns", "label": "Photos per row on desktop", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "header", "content": "Spacing" },
    { "type": "select", "id": "padding_top", "label": "Top spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" },
    { "type": "select", "id": "padding_bottom", "label": "Bottom spacing", "options": [{ "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "none" }
  ],
  "presets": [
    {
      "name": "Social gallery",
      "blocks": [
        { "type": "_gallery-image" },
        { "type": "_gallery-image" },
        { "type": "_gallery-image" },
        { "type": "_gallery-image" },
        { "type": "_gallery-image" }
      ]
    }
  ]
}
{% endschema %}
