<div class="section color-{{ section.settings.color_scheme }}" style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});">
  <div class="page-width contact">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- form 'contact', id: 'ContactForm', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message" role="status">{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="contact__row">
        <div class="field">
          <label class="field__label" for="ContactName">{{ 'contact.name' | t }}</label>
          <input class="field__input" type="text" id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}">
        </div>
        <div class="field">
          <label class="field__label" for="ContactEmail">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
          <input class="field__input" type="email" id="ContactEmail" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="ContactPhone">{{ 'contact.phone' | t }}</label>
        <input class="field__input" type="tel" id="ContactPhone" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
      </div>
      <div class="field">
        <label class="field__label" for="ContactBody">{{ 'contact.message' | t }}</label>
        <textarea class="field__input" id="ContactBody" name="contact[body]">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="button button--primary">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .contact {
    max-width: 808px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }
  .contact__form .field {
    width: 100%;
  }
  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    width: 100%;
  }
  @media (max-width: 749px) {
    .contact__row {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Send us a message"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top spacing",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "small"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "small"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
