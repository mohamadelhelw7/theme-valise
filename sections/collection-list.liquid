<section class="section color-{{ section.settings.color_scheme }}" style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }});">
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      description: section.settings.description,
      alignment: section.settings.header_alignment,
      link_url: section.settings.link,
      link_label: section.settings.link_label
    %}
    {%- liquid
      assign picked = false
      for b in section.blocks
        if b.settings.collection != blank
          assign picked = true
          break
        endif
      endfor
      assign auto_count = section.blocks.size
      if auto_count == 0
        assign auto_count = 4
      endif
      assign tints = 'var(--tint-2),var(--tint-4),var(--tint-1),var(--tint-3)' | split: ','
      assign shown = 0
    -%}
    {%- capture auto_cards -%}
      {%- unless picked or section.settings.auto_fill == false -%}
        {%- for c in collections -%}
          {%- if c.handle == 'all' or c.handle == 'frontpage' or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
          {%- assign tint_index = shown | modulo: 4 -%}
          {% render 'collection-card', collection: c, color: tints[tint_index] %}
          {%- assign shown = shown | plus: 1 -%}
          {%- if shown >= auto_count -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      {%- endunless -%}
    {%- endcapture -%}
    <div class="collection-list collection-list--{{ section.settings.tile_style }} collection-list--fit-{{ section.settings.image_fit }}{% if section.settings.stagger %} collection-list--stagger{% endif %}" style="--cl-cols: {{ section.settings.columns }};">
      {%- if shown > 0 -%}
        {{ auto_cards }}
      {%- else -%}
        {% content_for 'blocks' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .collection-list--arched .collection-card__media {
    border-radius: 999px 999px var(--radius-sm) var(--radius-sm);
    aspect-ratio: 3 / 4.2;
  }
  .collection-list--arched .collection-card__info {
    justify-content: center;
    text-align: center;
  }
  .collection-list--arched .collection-card__title {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: calc(1.5rem * var(--heading-scale));
    letter-spacing: var(--heading-ls);
    text-transform: var(--heading-case);
  }
  .collection-list--arched .collection-card:hover .collection-card__title {
    font-style: italic;
  }
  .heading-accent-color .collection-list--arched .collection-card:hover .collection-card__title {
    font-style: normal;
    color: var(--color-accent);
  }
  .collection-list--arched .collection-card__arrow {
    display: none;
  }
  @media (min-width: 750px) {
    .collection-list--stagger {
      padding-bottom: 72px;
    }
    .collection-list--stagger > :nth-child(even) {
      margin-top: 72px;
      margin-bottom: -72px;
    }
  }
  @supports (animation-timeline: view()) {
    @media (min-width: 750px) and (prefers-reduced-motion: no-preference) {
      .collection-list--stagger > * {
        animation: tile-drift linear both;
        animation-timeline: view();
      }
      .collection-list--stagger > :nth-child(even) {
        animation-name: tile-drift-far;
      }
      @keyframes tile-drift {
        from {
          translate: 0 40px;
        }
        to {
          translate: 0 -40px;
        }
      }
      @keyframes tile-drift-far {
        from {
          translate: 0 100px;
        }
        to {
          translate: 0 -100px;
        }
      }
    }
  }
  .collection-list--fit-contain .collection-card__media img {
    object-fit: contain;
    padding: 12%;
    mix-blend-mode: multiply;
  }
  .collection-list--slanted {
    --slant: 44px;
    --slant-gap: 10px;
    gap: 0;
  }
  .collection-list--slanted > * {
    margin-inline-start: calc((var(--slant) - var(--slant-gap)) * -1);
    clip-path: polygon(var(--slant) 0, 100% 0, calc(100% - var(--slant)) 100%, 0 100%);
  }
  [dir='rtl'] .collection-list--slanted > * {
    clip-path: polygon(0 0, calc(100% - var(--slant)) 0, 100% 100%, var(--slant) 100%);
  }
  .collection-list--slanted > :first-child {
    margin-inline-start: 0;
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--slant)) 100%, 0 100%);
  }
  .collection-list--slanted > :last-child {
    clip-path: polygon(var(--slant) 0, 100% 0, 100% 100%, 0 100%);
  }
  [dir='rtl'] .collection-list--slanted > :first-child {
    clip-path: polygon(0 0, 100% 0, 100% 100%, var(--slant) 100%);
  }
  [dir='rtl'] .collection-list--slanted > :last-child {
    clip-path: polygon(0 0, calc(100% - var(--slant)) 0, 100% 100%, 0 100%);
  }
  .collection-list--slanted > :only-child {
    clip-path: none;
  }
  .collection-list--slanted .collection-card {
    position: relative;
    gap: 0;
  }
  .collection-list--slanted .collection-card__media {
    border-radius: 0;
    aspect-ratio: 3 / 4;
  }
  .collection-list--slanted .collection-card__info {
    position: absolute;
    inset-inline: 0;
    bottom: 22px;
    justify-content: center;
    gap: 8px;
    pointer-events: none;
  }
  .collection-list--slanted .collection-card__title {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: var(--label-ls);
    text-transform: var(--label-case);
  }
  .collection-list--slanted .collection-card__count {
    display: none;
  }
  .collection-list--slanted .collection-card__arrow {
    width: auto;
    height: auto;
    border: 0;
    background: none;
  }
  .collection-list--slanted .collection-card:hover .collection-card__arrow {
    background: none;
    color: var(--color-accent);
  }
  @media (max-width: 749px) {
    .collection-list--slanted {
      --slant: 22px;
      --slant-gap: 6px;
      gap: 0;
    }
  }
  .collection-list {
    display: grid;
    grid-template-columns: repeat(var(--cl-cols), minmax(0, 1fr));
    gap: var(--grid-gap);
  }
  @media (max-width: 989px) {
    .collection-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 749px) {
    .collection-list {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: var(--grid-gap);
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .collection-list > * {
      flex: 0 0 72%;
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection list",
  "tag": "div",
  "class": "collection-list-section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "_collection-card"
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description",
      "default": "Totes, crossbody bags, backpacks and small leather goods."
    },
    {
      "type": "select",
      "id": "tile_style",
      "label": "Tile style",
      "options": [
        { "value": "standard", "label": "Name under photo" },
        { "value": "slanted", "label": "Slanted tiles" },
        { "value": "arched", "label": "Arched tiles" }
      ],
      "default": "slanted"
    },
    { "type": "checkbox", "id": "stagger", "label": "Offset every other tile", "info": "On desktop the tiles also drift at two speeds as shoppers scroll", "default": false },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Photo fit",
      "options": [
        { "value": "cover", "label": "Fill the tile" },
        { "value": "contain", "label": "Show the whole photo" }
      ],
      "default": "contain"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "auto_fill",
      "label": "Show my collections automatically",
      "info": "Until you pick a collection on a card, your store's collections are shown.",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All collections"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading layout",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "split",
          "label": "Split with accent line"
        }
      ],
      "default": "split"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top spacing",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        {
          "type": "_collection-card",
          "settings": {
            "title": "Totes",
            "color": "#DCE1D2"
          }
        },
        {
          "type": "_collection-card",
          "settings": {
            "title": "Crossbody",
            "color": "#F2E2C4"
          }
        },
        {
          "type": "_collection-card",
          "settings": {
            "title": "Backpacks",
            "color": "#EAD9CF"
          }
        },
        {
          "type": "_collection-card",
          "settings": {
            "title": "Small leather goods",
            "color": "#C9B8A6"
          }
        }
      ]
    }
  ]
}
{% endschema %}
