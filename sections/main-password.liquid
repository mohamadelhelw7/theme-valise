<div class="password">
  <div class="password__card">
    <div class="site-header__wordmark">{{ shop.name | escape }}<span class="site-header__dot">.</span></div>
    <h1 class="h1">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="password__message">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'password__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.label' | t }}</label>
        <input id="PasswordEmail" class="field__input" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required>
        <button type="submit" class="button button--primary">{{ 'newsletter.button' | t }}</button>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>{{ 'templates.password.login' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <label class="visually-hidden" for="StorePassword">{{ 'templates.password.password' | t }}</label>
        <input id="StorePassword" class="field__input" type="password" name="password" placeholder="{{ 'templates.password.password' | t }}" autocomplete="current-password">
        <button type="submit" class="button button--secondary">{{ 'templates.password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% stylesheet %}
  .password {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px 16px;
    background: var(--tint-1);
  }
  .password__card {
    width: min(520px, 100%);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 48px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-align: center;
  }
  .password__message {
    color: var(--color-body);
  }
  .password__form {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .password__form .field__input {
    flex: 1 1 220px;
  }
  .password__login summary {
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 12px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }]
}
{% endschema %}
