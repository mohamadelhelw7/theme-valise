{% doc %}
  Renders one row of the scrolling words section: a word on each side of a photo.
  The words stay in view while the photo scrolls past.
{% enddoc %}

{%- liquid
  assign pair_index = 0
  for b in section.blocks
    if b.id == block.id
      assign pair_index = forloop.index0
      break
    endif
  endfor
  assign fallback_product = collections.all.products[pair_index]
  assign pair_image = block.settings.image | default: fallback_product.featured_image
  assign pair_label = block.settings.word_start | append: ' ' | append: block.settings.word_end | strip | escape
-%}

<div class="word-pair" {{ block.shopify_attributes }}>
  <div class="word-pair__word word-pair__word--start">
    <span class="display-word">{{ block.settings.word_start | escape }}</span>
  </div>
  <div class="word-pair__media">
    {%- if pair_image != blank -%}
      {{
        pair_image
        | image_url: width: 1100
        | image_tag: widths: '400, 600, 800, 1100', sizes: '(min-width: 750px) 28vw, 72vw', loading: 'lazy', alt: ''
      }}
    {%- else -%}
      {%- assign ph_n = pair_index | plus: 1 -%}{% render 'media-placeholder', kind: 'product', index: ph_n %}
    {%- endif -%}
    {%- if block.settings.link != blank -%}
      <a class="word-pair__link" href="{{ block.settings.link }}" aria-label="{{ pair_label }}"></a>
    {%- endif -%}
  </div>
  <div class="word-pair__word word-pair__word--end">
    <span class="display-word">{{ block.settings.word_end | escape }}</span>
  </div>
  {%- if block.settings.accent_image != blank -%}
    <div class="word-pair__accent word-pair__accent--{{ block.settings.accent_side }}" aria-hidden="true">
      {{
        block.settings.accent_image
        | image_url: width: 500
        | image_tag: widths: '200, 350, 500', sizes: '14vw', loading: 'lazy', alt: ''
      }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Word pair",
  "tag": null,
  "settings": [
    { "type": "text", "id": "word_start", "label": "First word", "default": "Work" },
    { "type": "text", "id": "word_end", "label": "Second word", "default": "Days" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Defaults to a product photo. Portrait photos work best." },
    { "type": "url", "id": "link", "label": "Photo link" },
    { "type": "header", "content": "Floating cut-out" },
    { "type": "image_picker", "id": "accent_image", "label": "Cut-out image", "info": "Optional PNG with a transparent background, such as a single product" },
    {
      "type": "select",
      "id": "accent_side",
      "label": "Cut-out side",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "end", "label": "End" }
      ],
      "default": "start"
    }
  ],
  "presets": [{ "name": "Word pair" }]
}
{% endschema %}
