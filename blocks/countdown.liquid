{% doc %}
  Renders a countdown timer to a fixed date and time.

  @example
  {% content_for 'block', type: 'countdown', id: 'countdown' %}
{% enddoc %}

{%- liquid
  assign end_date = block.settings.end_date | strip
  assign end_time = block.settings.end_time | strip | default: '23:59'
  assign end_iso = end_date | append: 'T' | append: end_time | append: ':00' | append: block.settings.timezone
  assign timer_label = block.settings.heading
  if timer_label == blank
    assign timer_label = 'sections.countdown.label' | t
  endif
-%}

<countdown-timer
  class="countdown countdown--{{ block.settings.style }} countdown--{{ block.settings.size }}"
  data-end="{{ end_iso }}"
  data-expired="{{ block.settings.expired }}"
  style="--countdown-align: {{ block.settings.alignment }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <p class="countdown__heading">{{ block.settings.heading | escape }}</p>
  {%- endif -%}
  <div class="countdown__clock" data-countdown-clock role="timer" aria-label="{{ timer_label | escape }}" hidden>
    {%- assign units = 'days,hours,minutes,seconds' | split: ',' -%}
    {%- for unit in units -%}
      <div class="countdown__unit">
        <span class="countdown__value" data-unit="{{ unit }}">00</span>
        {%- if block.settings.show_labels -%}
          <span class="countdown__label">
            {%- case unit -%}
              {%- when 'days' -%}{{ 'sections.countdown.days' | t }}
              {%- when 'hours' -%}{{ 'sections.countdown.hours' | t }}
              {%- when 'minutes' -%}{{ 'sections.countdown.minutes' | t }}
              {%- else -%}{{ 'sections.countdown.seconds' | t }}
            {%- endcase -%}
          </span>
        {%- endif -%}
      </div>
      {%- unless forloop.last or block.settings.style == 'boxes' -%}
        <span class="countdown__sep" aria-hidden="true">:</span>
      {%- endunless -%}
    {%- endfor -%}
  </div>
  <p class="countdown__done" data-countdown-done hidden>{{ block.settings.expired_message | escape }}</p>
  <p class="countdown__invalid" data-countdown-invalid hidden>{{ 'sections.countdown.invalid' | t }}</p>
</countdown-timer>

{% stylesheet %}
  .countdown {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: var(--countdown-align);
    text-align: center;
  }
  .countdown__heading {
    font-size: 0.875rem;
    font-weight: 600;
  }
  .countdown__clock {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .countdown__clock[hidden] {
    display: none;
  }
  .countdown__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 48px;
  }
  .countdown--boxes .countdown__unit {
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    padding: 10px 8px;
    min-width: 64px;
  }
  .countdown__value {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 1.75rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    direction: ltr;
  }
  .countdown--large .countdown__value {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
  }
  .countdown--large.countdown--boxes .countdown__unit {
    min-width: 84px;
    padding: 16px 10px;
  }
  .countdown__label {
    font-size: 0.6875rem;
    text-transform: var(--label-case);
    letter-spacing: calc(var(--label-ls) * 0.6);
    color: var(--color-muted);
    margin-top: 6px;
  }
  .countdown__sep {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-muted);
  }
  .countdown__done {
    font-weight: 600;
  }
  .countdown__invalid {
    font-size: 0.8125rem;
    color: var(--color-sale);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Countdown",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Label", "default": "Offer ends in" },
    { "type": "text", "id": "end_date", "label": "End date", "info": "Format YYYY-MM-DD, for example 2026-12-31", "default": "2026-12-31" },
    { "type": "text", "id": "end_time", "label": "End time", "info": "24 hour format HH:MM, for example 23:59", "default": "23:59" },
    {
      "type": "select",
      "id": "timezone",
      "label": "Time zone",
      "options": [
        { "value": "+02:00", "label": "Egypt winter time (UTC+2)" },
        { "value": "+03:00", "label": "Egypt summer time, Saudi Arabia (UTC+3)" },
        { "value": "+04:00", "label": "UAE (UTC+4)" },
        { "value": "+01:00", "label": "UTC+1" },
        { "value": "Z", "label": "UTC" }
      ],
      "default": "+02:00"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "boxes", "label": "Boxes" },
        { "value": "inline", "label": "Inline" }
      ],
      "default": "boxes"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "flex-start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "End" }
      ],
      "default": "flex-start"
    },
    { "type": "checkbox", "id": "show_labels", "label": "Show day, hour, minute labels", "default": true },
    {
      "type": "select",
      "id": "expired",
      "label": "When the countdown ends",
      "options": [
        { "value": "hide", "label": "Hide it" },
        { "value": "message", "label": "Show a message" }
      ],
      "default": "hide"
    },
    { "type": "text", "id": "expired_message", "label": "Message", "default": "This offer has ended" }
  ],
  "presets": [{ "name": "Countdown", "category": "Promotion" }]
}
{% endschema %}
