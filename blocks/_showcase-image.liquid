{% doc %}
  Renders one photo tile in the collection showcase. Falls back to a product photo from the section's collection.
{% enddoc %}

{%- liquid
  assign tile_index = 0
  for b in section.blocks
    if b.id == block.id
      assign tile_index = forloop.index0
      break
    endif
  endfor
  assign source = section.settings.collection | default: collections.all
  assign fallback_product = source.products[tile_index]
  assign tile_image = block.settings.image | default: fallback_product.featured_image
-%}

<div class="showcase-tile" {{ block.shopify_attributes }}>
  {%- if tile_image != blank -%}
    {{
      tile_image
      | image_url: width: 800
      | image_tag: widths: '300, 500, 800', sizes: '(min-width: 990px) 20vw, 45vw', loading: 'lazy', alt: ''
    }}
  {%- else -%}
    {%- assign ph_n = tile_index | plus: 1 -%}{% render 'media-placeholder', kind: 'product', index: ph_n %}
  {%- endif -%}
  {%- if block.settings.link != blank -%}
    <a class="showcase-tile__link" href="{{ block.settings.link }}" aria-label="{{ block.settings.label | default: section.settings.heading | escape }}"></a>
  {%- endif -%}
  {%- if block.settings.label != blank -%}
    <span class="showcase-tile__label">{{ block.settings.label | escape }}</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Photo",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to a product photo" },
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Photo" }]
}
{% endschema %}
