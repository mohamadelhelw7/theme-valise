{% doc %}
  Product add-ons: extras that go to the cart together with this product when ticked.
  Three styles: checkbox rows, a grid of tiles that show a check when picked,
  and cards with a switch in a slider. Products come from Shopify's recommendations or are picked by hand.

  @example
  {% content_for 'block', type: 'product-addons', id: 'product-addons' %}
{% enddoc %}

{%- liquid
  assign addon_style = block.settings.style
  assign addon_url = ''
  if block.settings.source != 'picked' and product != blank
    assign addon_url = routes.product_recommendations_url | append: '?product_id=' | append: product.id | append: '&limit=10&intent=' | append: block.settings.source | append: '&section_id=upsell-kit-render'
  endif
-%}

<product-addons
  class="addons addons--{{ addon_style }}{% if block.settings.accent %} addons--accent{% endif %}"
  data-kit="addon-{{ addon_style }}"
  data-limit="{{ block.settings.limit }}"
  {% if block.settings.badge != blank %}
    data-badge="{{ block.settings.badge | escape }}"
  {% endif %}
  {% if addon_url != blank %}
    data-url="{{ addon_url }}"
    {% unless request.design_mode %}
      hidden
    {% endunless %}
  {% endif %}
  {% if request.design_mode %}
    data-editor="true"
  {% endif %}
  {{ block.shopify_attributes }}
>
  <div class="addons__head">
    {%- if block.settings.heading != blank -%}
      <p class="addons__heading">{{ block.settings.heading | escape }}</p>
    {%- endif -%}
    {%- if addon_style == 'toggles' -%}
      <div class="addons__arrows" data-addon-arrows hidden>
        <button type="button" class="addons__arrow" data-addon-step="-1" aria-label="{{ 'upsells.previous' | t }}">
          {%- render 'icon', icon: 'chevron-left' -%}
        </button>
        <button type="button" class="addons__arrow" data-addon-step="1" aria-label="{{ 'upsells.next' | t }}">
          {%- render 'icon', icon: 'chevron-right' -%}
        </button>
      </div>
    {%- endif -%}
  </div>
  <div class="addons__items" data-upsell-target>
    {%- if block.settings.source == 'picked' -%}
      {%- for picked in block.settings.products limit: block.settings.limit -%}
        {%- if picked.id == product.id -%}{%- continue -%}{%- endif -%}
        {% render 'upsell-kit-addon', product: picked, layout: addon_style, badge: block.settings.badge %}
      {%- endfor -%}
    {%- endif -%}
  </div>
  <p class="addons__note">{{ 'upsells.addons_note' | t }}</p>
  {%- if request.design_mode -%}
    <p class="upsell-kit-hint" data-addon-empty hidden>
      {%- if block.settings.source == 'picked' -%}
        {{ 'upsells.editor_pick' | t }}
      {%- else -%}
        {{ 'upsells.editor_empty' | t }}
      {%- endif -%}
    </p>
  {%- endif -%}
</product-addons>

{% javascript %}
  if (!customElements.get('product-addons')) {
    class ProductAddons extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-upsell-target]');
        this.addEventListener('change', (event) => {
          const select = event.target.closest('[data-addon-variant]');
          if (!select) return;
          const input = select.closest('[data-upsell-item]')?.querySelector('[data-upsell-addon]');
          if (input) input.value = select.value;
        });
        this.addEventListener('click', (event) => {
          const arrow = event.target.closest('[data-addon-step]');
          if (!arrow || !this.track) return;
          const rtl = getComputedStyle(this).direction === 'rtl';
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const step = Number(arrow.dataset.addonStep) * this.track.clientWidth * 0.8 * (rtl ? -1 : 1);
          this.track.scrollBy({ left: step, behavior: reduce ? 'auto' : 'smooth' });
        });
        // Untick the add-ons after the product goes to the cart, so they aren't added twice.
        this.onAdded = (event) => {
          const items = (event.detail && event.detail.items) || [];
          const added = new Set(items.map((item) => String(item.variant_id || item.id)));
          this.querySelectorAll('[data-upsell-addon]:checked').forEach((input) => {
            if (added.has(input.value)) input.checked = false;
          });
        };
        document.addEventListener('cart:added', this.onAdded);
        const url = this.dataset.url;
        if (!url) {
          this.finish();
          return;
        }
        const cache = (window.upsellKitCache = window.upsellKitCache || new Map());
        if (!cache.has(url)) {
          cache.set(
            url,
            fetch(url)
              .then((response) => response.text())
              .then((html) => new DOMParser().parseFromString(html, 'text/html'))
          );
        }
        cache
          .get(url)
          .then((doc) => {
            const results = doc.querySelector(`[data-kit="${this.dataset.kit}"]`);
            if (results && this.track) this.track.innerHTML = results.innerHTML;
            this.finish();
          })
          .catch(() => this.finish());
      }

      disconnectedCallback() {
        document.removeEventListener('cart:added', this.onAdded);
      }

      finish() {
        const items = this.track ? Array.from(this.track.querySelectorAll('[data-upsell-item]')) : [];
        const limit = Number(this.dataset.limit) || items.length;
        items.slice(limit).forEach((item) => item.remove());
        if (this.dataset.badge) {
          this.querySelectorAll('[data-addon-badge]').forEach((badge) => {
            badge.textContent = this.dataset.badge;
            badge.hidden = false;
          });
        }
        const empty = items.length === 0;
        const note = this.querySelector('.addons__note');
        if (note) note.hidden = empty;
        if (this.dataset.editor === 'true') {
          const hint = this.querySelector('[data-addon-empty]');
          if (hint) hint.hidden = !empty;
        } else {
          this.hidden = empty;
        }
        const arrows = this.querySelector('[data-addon-arrows]');
        if (arrows && this.track) {
          requestAnimationFrame(() => {
            arrows.hidden = this.track.scrollWidth <= this.track.clientWidth + 4;
          });
        }
      }
    }
    customElements.define('product-addons', ProductAddons);
  }
{% endjavascript %}

{% stylesheet %}
  .upsell-kit-hint {
    margin: 0;
    padding: 12px;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .upsell-kit-hint[hidden] {
    display: none;
  }
  product-addons {
    display: grid;
    gap: 12px;
  }
  product-addons[hidden] {
    display: none;
  }
  .addons__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .addons__head:empty {
    display: none;
  }
  .addons__heading {
    margin: 0;
    font-family: var(--font-label, inherit);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--label-ls);
    text-transform: var(--label-case);
  }
  .addons__arrows {
    display: flex;
    gap: 6px;
  }
  .addons__arrows[hidden] {
    display: none;
  }
  .addons__arrow {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .addons__arrow:hover {
    border-color: var(--color-text);
  }
  .addons__arrow .icon {
    width: 16px;
    height: 16px;
  }
  [dir='rtl'] .addons__arrow .icon {
    transform: scaleX(-1);
  }
  .addons__note {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .addons__note[hidden] {
    display: none;
  }

  /* Shared parts of one add-on */
  .addon-item__pick {
    position: relative;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .addon-item__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .addon-item__media {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--tint-1);
  }
  .addon-item__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .addon-item__info {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .addon-item__title {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.875rem;
    font-weight: 500;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .addon-item .price {
    font-size: 0.8125rem;
  }
  .addon-item__badge {
    justify-self: start;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .addon-item__badge[hidden] {
    display: none;
  }
  .addon-item__select {
    min-height: 36px;
    font-size: 0.8125rem;
  }

  /* Checkbox rows */
  .addons--checks .addons__items {
    display: grid;
    gap: 8px;
  }
  .addon-item--checks {
    display: grid;
    gap: 8px;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .addon-item--checks:has(.addon-item__input:checked) {
    border-color: var(--color-text);
    background: color-mix(in srgb, var(--color-text) 4%, transparent);
  }
  .addon-item--checks .addon-item__pick {
    display: grid;
    grid-template-columns: auto 48px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
  }
  .addon-item--checks .addon-item__media {
    width: 48px;
    height: 48px;
  }
  .addon-item__box {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--color-text);
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease;
  }
  .addon-item__box .icon {
    width: 14px;
    height: 14px;
    opacity: 0;
  }
  .addon-item__input:checked + .addon-item__box {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .addon-item__input:checked + .addon-item__box .icon {
    opacity: 1;
  }

  /* Tiles */
  .addons--tiles .addons__items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(96px, 40%), 1fr));
    gap: 12px;
    align-items: start;
  }
  .addon-item--tiles {
    display: grid;
    gap: 6px;
  }
  .addon-item--tiles .addon-item__pick {
    display: grid;
    gap: 8px;
  }
  .addon-item--tiles .addon-item__media {
    position: relative;
    aspect-ratio: 1;
    outline: 1px solid var(--color-border);
    outline-offset: -1px;
    transition: outline-color 0.2s ease;
  }
  .addon-item--tiles .addon-item__pick:hover .addon-item__media {
    outline-color: var(--color-text);
  }
  .addon-item--tiles .addon-item__input:checked + .addon-item__media {
    outline: 2px solid var(--color-text);
    outline-offset: -2px;
  }
  .addon-item__tick {
    position: absolute;
    inset-block-start: 6px;
    inset-inline-end: 6px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-bg);
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .addon-item__tick .icon {
    width: 13px;
    height: 13px;
  }
  .addon-item--tiles .addon-item__input:checked + .addon-item__media .addon-item__tick {
    opacity: 1;
    transform: none;
  }
  .addon-item--tiles .addon-item__info {
    justify-items: center;
    text-align: center;
  }
  .addon-item--tiles .addon-item__badge {
    justify-self: center;
  }
  .addon-item--tiles .addon-item__title {
    font-size: 0.8125rem;
  }

  /* Cards with a switch */
  .addons--toggles .addons__items {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .addons--toggles .addons__items::-webkit-scrollbar {
    display: none;
  }
  .addon-item--toggles {
    --switch-on: var(--color-text);
    --switch-knob: var(--color-bg);
    flex: 0 0 min(360px, 88%);
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 8px 14px;
    padding: 14px;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    scroll-snap-align: start;
  }
  .addons--toggles .addon-item--toggles:only-child {
    flex-basis: 100%;
  }
  .addons--accent .addon-item--toggles {
    --switch-on: var(--color-accent-contrast);
    --switch-knob: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .addons--accent .addon-item--toggles .price,
  .addons--accent .addon-item--toggles .price__compare {
    color: inherit;
  }
  .addons--accent .addon-item--toggles .addon-item__badge {
    background: var(--color-accent-contrast);
    color: var(--color-accent);
  }
  .addon-item--toggles .addon-item__pick {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
  }
  .addon-item--toggles .addon-item__media {
    width: 72px;
    height: 72px;
  }
  .addon-item--toggles .addon-item__title {
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .addon-item__switch {
    position: relative;
    width: 46px;
    height: 26px;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 24%, transparent);
    transition: background-color 0.2s ease;
  }
  .addon-item__switch::after {
    content: '';
    position: absolute;
    inset-block-start: 3px;
    inset-inline-start: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--switch-knob);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
    transition: transform 0.2s ease;
  }
  .addon-item__input:checked ~ .addon-item__switch {
    background: var(--switch-on);
  }
  .addon-item__input:checked ~ .addon-item__switch::after {
    transform: translateX(20px);
  }
  [dir='rtl'] .addon-item__input:checked ~ .addon-item__switch::after {
    transform: translateX(-20px);
  }
  .addon-item--toggles .addon-item__link {
    grid-column: 1;
    justify-self: center;
    font-size: 0.75rem;
    color: inherit;
    text-underline-offset: 3px;
  }
  .addon-item--toggles .addon-item__select {
    grid-column: 2;
    grid-row: 2;
  }

  /* Keyboard focus shows on the visible part */
  .addon-item__input:focus-visible + .addon-item__box,
  .addon-item__input:focus-visible + .addon-item__media,
  .addon-item__input:focus-visible ~ .addon-item__switch {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .addons--accent .addon-item__input:focus-visible ~ .addon-item__switch {
    outline-color: var(--color-accent-contrast);
  }
  @media (prefers-reduced-motion: reduce) {
    .addon-item__switch::after,
    .addon-item__tick {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product add-ons",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Add-ons" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "checks", "label": "Checkbox rows" },
        { "value": "tiles", "label": "Tiles that show a check" },
        { "value": "toggles", "label": "Cards with a switch" }
      ],
      "default": "tiles"
    },
    {
      "type": "checkbox",
      "id": "accent",
      "label": "Use the accent color on cards with a switch",
      "default": false
    },
    {
      "type": "select",
      "id": "source",
      "label": "Products",
      "options": [
        { "value": "complementary", "label": "Complementary products" },
        { "value": "related", "label": "Related products" },
        { "value": "picked", "label": "Products I pick" }
      ],
      "default": "complementary",
      "info": "Set complementary products in the Search & Discovery app. Related products come from Shopify automatically."
    },
    { "type": "product_list", "id": "products", "label": "Add-ons", "limit": 8, "info": "Used with Products I pick" },
    { "type": "range", "id": "limit", "label": "Add-ons to show", "min": 1, "max": 8, "step": 1, "default": 4 },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge on each add-on",
      "info": "Only something true, for example a real time limit. Leave empty to hide it."
    }
  ],
  "presets": [
    { "name": "Add-ons: tiles", "category": "Upsells" },
    { "name": "Add-ons: checkboxes", "category": "Upsells", "settings": { "style": "checks", "limit": 2 } },
    { "name": "Add-ons: switches", "category": "Upsells", "settings": { "style": "toggles", "limit": 4 } }
  ]
}
{% endschema %}
