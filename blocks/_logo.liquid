{% doc %}
  Renders one logo in the logo strip: an image, or the name as text when no image is set.
  Empty logos only show in the theme editor.
{% enddoc %}

{%- liquid
  assign logo_name = block.settings.name | escape
  assign logo_alt = block.settings.name | default: block.settings.image.alt | escape
-%}

{%- if block.settings.image != blank or block.settings.name != blank or request.design_mode -%}
  <li class="logo-strip__item" {{ block.shopify_attributes }}>
    {%- if block.settings.image != blank -%}
      {{
        block.settings.image
        | image_url: width: 400
        | image_tag: widths: '200, 400', sizes: '200px', loading: 'lazy', alt: logo_alt, class: 'logo-strip__image'
      }}
    {%- elsif block.settings.name != blank -%}
      <span class="logo-strip__name">{{ logo_name }}</span>
    {%- else -%}
      <span class="logo-strip__empty">{{ 'sections.logo_strip.add_logo' | t }}</span>
    {%- endif -%}
    {%- if block.settings.link != blank -%}
      <a class="logo-strip__link" href="{{ block.settings.link }}" aria-label="{{ logo_alt | default: block.settings.link }}"></a>
    {%- endif -%}
  </li>
{%- endif -%}

{% schema %}
{
  "name": "Logo",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Logo", "info": "Use logos you have permission to show, such as press or stockists" },
    { "type": "text", "id": "name", "label": "Name", "info": "Shown as text when there is no logo image" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Logo" }]
}
{% endschema %}
