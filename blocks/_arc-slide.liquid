{% doc %}
  Renders one photo on the curved gallery. Its heading, text and link show under the curve when it is in front.
{% enddoc %}

{%- liquid
  assign arc_index = 0
  for b in section.blocks
    if b.id == block.id
      assign arc_index = forloop.index0
      break
    endif
  endfor
  assign fallback_product = collections.all.products[arc_index]
  assign arc_image = block.settings.image | default: fallback_product.featured_image
  assign arc_label = block.settings.heading | default: block.settings.link_label | escape
-%}

<button type="button" class="arc__item" data-arc-item aria-label="{{ arc_label }}" {{ block.shopify_attributes }}>
  {%- if arc_image != blank -%}
    {{
      arc_image
      | image_url: width: 700
      | image_tag: widths: '300, 500, 700', sizes: '(min-width: 990px) 18vw, 44vw', loading: 'lazy', alt: ''
    }}
  {%- else -%}
    {%- assign ph_n = arc_index | plus: 1 -%}{% render 'media-placeholder', kind: 'product', index: ph_n %}
  {%- endif -%}
</button>

{% schema %}
{
  "name": "Gallery photo",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to a product photo. Portrait photos work best." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Totes" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Room for the whole day." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore" },
    { "type": "url", "id": "link", "label": "Link", "default": "/collections/all" }
  ],
  "presets": [{ "name": "Gallery photo" }]
}
{% endschema %}
