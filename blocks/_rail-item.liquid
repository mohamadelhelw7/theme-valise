{% doc %}
  Renders one look in the horizontal lookbook: a photo with a number, a title and an optional product price.
  Falls back to the picked product's photo, then to a store product photo.
{% enddoc %}

{%- liquid
  assign item_index = 0
  for b in section.blocks
    if b.id == block.id
      assign item_index = forloop.index
      break
    endif
  endfor
  assign rail_product = block.settings.product
  assign fallback_index = item_index | minus: 1
  assign fallback_product = collections.all.products[fallback_index]
  assign rail_image = block.settings.image | default: rail_product.featured_image | default: fallback_product.featured_image
  assign rail_title = block.settings.title | default: rail_product.title
  assign rail_link = block.settings.link | default: rail_product.url
  assign rail_alt = rail_image.alt | default: rail_title | escape
  if item_index < 10
    assign item_number = '0' | append: item_index
  else
    assign item_number = item_index | append: ''
  endif
-%}

<li class="rail-item rail-item--{{ block.settings.shape }}" {{ block.shopify_attributes }}>
  <div class="rail-item__media">
    {%- if rail_image != blank -%}
      {{
        rail_image
        | image_url: width: 1200
        | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 750px) 40vw, 80vw', loading: 'lazy', alt: rail_alt
      }}
    {%- else -%}
      {% render 'media-placeholder', kind: 'product', index: item_index %}
    {%- endif -%}
  </div>
  <div class="rail-item__caption">
    <span class="rail-item__number">{{ item_number }}</span>
    <div class="rail-item__text">
      {%- if rail_title != blank -%}
        <p class="rail-item__title">{{ rail_title | escape }}</p>
      {%- endif -%}
      {%- if block.settings.subtitle != blank -%}
        <p class="rail-item__subtitle">{{ block.settings.subtitle | escape }}</p>
      {%- elsif rail_product != blank -%}
        <p class="rail-item__subtitle">{% render 'format-money', amount: rail_product.price %}</p>
      {%- endif -%}
    </div>
  </div>
  {%- if rail_link != blank -%}
    <a class="rail-item__link" href="{{ rail_link }}" aria-label="{{ rail_title | default: item_number | escape }}"></a>
  {%- endif -%}
</li>

{% schema %}
{
  "name": "Look",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Defaults to the product photo" },
    { "type": "product", "id": "product", "label": "Product", "info": "Optional. Shows its price and links to it." },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "shape",
      "label": "Photo shape",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "arch", "label": "Arched portrait" }
      ],
      "default": "portrait"
    }
  ],
  "presets": [{ "name": "Look" }]
}
{% endschema %}
