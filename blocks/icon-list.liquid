{% doc %}
  Renders a row or grid of icon items, such as product benefits.

  @example
  {% content_for 'block', type: 'icon-list', id: 'icon-list' %}
{% enddoc %}

<div
  class="icon-list icon-list--{{ block.settings.layout }}{% if block.settings.boxed %} icon-list--boxed{% endif %}"
  style="--icon-cols: {{ block.settings.columns }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <p class="icon-list__heading">{{ block.settings.heading | escape }}</p>
  {%- endif -%}
  <ul class="icon-list__items" role="list">
    {% content_for 'blocks' %}
  </ul>
</div>

{% stylesheet %}
  .icon-list__heading {
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .icon-list__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .icon-list--grid .icon-list__items {
    grid-template-columns: repeat(var(--icon-cols), minmax(0, 1fr));
  }
  .icon-list--row .icon-list__items {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  .icon-list--boxed .icon-item {
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    padding: 14px;
  }
  .icon-list--grid.icon-list--boxed .icon-item {
    flex-direction: column;
    align-items: flex-start;
  }
  @media (max-width: 749px) {
    .icon-list--grid .icon-list__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Icons",
  "tag": null,
  "blocks": [{ "type": "_icon-item" }],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "row", "label": "Inline row" },
        { "value": "list", "label": "List" }
      ],
      "default": "grid"
    },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 3, "visible_if": "{{ block.settings.layout == 'grid' }}" },
    { "type": "checkbox", "id": "boxed", "label": "Show items in cards", "default": true }
  ],
  "presets": [
    {
      "name": "Icons",
      "category": "Product",
      "blocks": [
        { "type": "_icon-item", "settings": { "icon": "gem", "title": "Chosen materials" } },
        { "type": "_icon-item", "settings": { "icon": "heart", "title": "Secure checkout" } },
        { "type": "_icon-item", "settings": { "icon": "return", "title": "Returns" } }
      ]
    }
  ]
}
{% endschema %}
