{% doc %}
  Renders one item in the Marquee section: a phrase, an optional small image, or both.

  @example
  {% content_for 'block', type: '_marquee-item', id: 'item' %}
{% enddoc %}

<span class="marquee__item" {{ block.shopify_attributes }}>
  {%- if block.settings.image -%}
    <span class="marquee__image">
      {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
    </span>
  {%- endif -%}
  {%- if block.settings.text != blank -%}
    {%- if block.settings.link != blank -%}
      <a href="{{ block.settings.link }}" class="marquee__text">{{ block.settings.text | escape }}</a>
    {%- else -%}
      <span class="marquee__text">{{ block.settings.text | escape }}</span>
    {%- endif -%}
  {%- endif -%}
</span>

{% schema %}
{
  "name": "Marquee item",
  "tag": null,
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Chosen materials" },
    { "type": "image_picker", "id": "image", "label": "Small image", "info": "Shown before the text, sized to the text height" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Marquee item" }]
}
{% endschema %}
