{% doc %}
  Renders one tile in the bento grid: a photo, a video, a product, a collection or a text panel.
  Empty product, collection and photo tiles fall back to products from the store.
{% enddoc %}

{%- liquid
  assign tile_index = 0
  for b in section.blocks
    if b.id == block.id
      assign tile_index = forloop.index0
      break
    endif
  endfor
  assign kind = block.settings.kind
  assign fallback = collections.all.products[tile_index]

  assign tile_product = nil
  assign tile_collection = nil
  if kind == 'product'
    assign tile_product = block.settings.product | default: fallback
  elsif kind == 'collection'
    assign tile_collection = block.settings.collection | default: collections.all
  endif

  assign tile_image = block.settings.image
  if tile_image == blank
    if kind == 'product'
      assign tile_image = tile_product.featured_image
    elsif kind == 'collection'
      assign tile_image = tile_collection.featured_image | default: tile_collection.products.first.featured_image
    elsif kind == 'image'
      assign tile_image = fallback.featured_image
    endif
  endif

  assign tile_heading = block.settings.heading
  assign tile_link = block.settings.link
  if kind == 'product' and tile_product != blank
    assign tile_heading = tile_heading | default: tile_product.title
    assign tile_link = tile_link | default: tile_product.url
  elsif kind == 'collection'
    assign tile_heading = tile_heading | default: tile_collection.title
    assign tile_link = tile_link | default: tile_collection.url
  endif
  assign tile_label = tile_heading | default: block.settings.link_label | default: block.settings.eyebrow

  case block.settings.width
    when '1'
      assign tile_sizes = '(min-width: 990px) 25vw, 50vw'
    when '2'
      assign tile_sizes = '(min-width: 990px) 50vw, 100vw'
    else
      assign tile_sizes = '(min-width: 990px) 75vw, 100vw'
  endcase
-%}

<div
  class="bento-tile bento-tile--{{ kind }} bento-tile--w{{ block.settings.width }} bento-tile--h{{ block.settings.height }} color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  {%- unless kind == 'text' -%}
    <div class="bento-tile__media">
      {%- if kind == 'video' and block.settings.video != blank -%}
        {{
          block.settings.video
          | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1200x', class: 'bento-tile__video'
        }}
      {%- elsif tile_image != blank -%}
        {{
          tile_image
          | image_url: width: 1400
          | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: tile_sizes, alt: '', class: 'bento-tile__image'
        }}
      {%- else -%}
        {%- assign ph_n = tile_index | plus: 1 -%}{% render 'media-placeholder', kind: 'lifestyle', index: ph_n %}
      {%- endif -%}
    </div>
  {%- endunless -%}

  <div class="bento-tile__content">
    {%- if block.settings.eyebrow != blank -%}
      <span class="bento-tile__eyebrow">{{ block.settings.eyebrow | escape }}</span>
    {%- endif -%}
    {%- if kind == 'product' and tile_product != blank -%}
      <div class="bento-tile__product">
        <span class="bento-tile__title">{{ tile_heading | escape }}</span>
        {% render 'price', product: tile_product %}
      </div>
    {%- elsif tile_heading != blank -%}
      <p class="bento-tile__heading{% if kind == 'text' %} bento-tile__heading--big{% endif %}">{{ tile_heading | escape }}</p>
    {%- endif -%}
    {%- if block.settings.text != blank -%}
      <p class="bento-tile__text">{{ block.settings.text | escape }}</p>
    {%- endif -%}
    {%- if block.settings.link_label != blank and tile_link != blank -%}
      <span class="bento-tile__cta">
        {{- block.settings.link_label | escape -}}
        {% render 'icon', icon: 'arrow-up-right' %}
      </span>
    {%- endif -%}
  </div>

  {%- if tile_link != blank and tile_label != blank -%}
    <a class="bento-tile__link" href="{{ tile_link }}" aria-label="{{ tile_label | escape }}"></a>
  {%- endif -%}

  {%- if kind == 'product' and tile_product != blank -%}
    <div class="bento-tile__actions">
      {%- if settings.wishlist_enable -%}
        <button
          type="button"
          class="save-toggle"
          data-save="{{ tile_product.handle }}"
          data-save-title="{{ tile_product.title | escape }}"
          aria-pressed="false"
          aria-label="{{ 'saved.save' | t: title: tile_product.title | escape }}"
        >
          {% render 'icon', icon: 'heart' %}
        </button>
      {%- endif -%}
      {%- if tile_product.available and tile_product.has_only_default_variant -%}
        {%- form 'product', tile_product, data-product-form: '', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ tile_product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="icon-button bento-tile__add" aria-label="{{ 'products.product.add_title_to_cart' | t: title: tile_product.title | escape }}">
            {% render 'icon', icon: 'plus' %}
          </button>
        {%- endform -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Tile",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "kind",
      "label": "Tile type",
      "options": [
        { "value": "image", "label": "Photo" },
        { "value": "video", "label": "Video" },
        { "value": "product", "label": "Product" },
        { "value": "collection", "label": "Collection" },
        { "value": "text", "label": "Text" }
      ],
      "default": "image"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "1", "label": "1 row" },
        { "value": "2", "label": "2 rows" }
      ],
      "default": "1"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "product", "id": "product", "label": "Product", "info": "Product tiles only. Defaults to a product from your store." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Collection tiles only. Defaults to all products." },
    { "type": "video", "id": "video", "label": "Video", "info": "Plays muted on a loop", "visible_if": "{{ block.settings.kind == 'video' }}" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to a product photo", "visible_if": "{{ block.settings.kind != 'text' }}" },
    { "type": "text", "id": "eyebrow", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Product and collection tiles use their title when this is empty" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link", "info": "Product and collection tiles link to their page when this is empty" }
  ],
  "presets": [{ "name": "Tile" }]
}
{% endschema %}
