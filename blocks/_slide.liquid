{% doc %}
  Renders one slideshow slide: one full-width photo or two photos side by side,
  an optional framed inset photo or video, and the slide text with up to two buttons.
{% enddoc %}

{%- liquid
  assign is_first = false
  if section.blocks.first.id == block.id
    assign is_first = true
  endif
  assign slide_index = 0
  for b in section.blocks
    if b.id == block.id
      assign slide_index = forloop.index0
      break
    endif
  endfor
  assign slide_number = slide_index | plus: 1
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if is_first
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif
  assign image_alt = block.settings.image.alt | default: block.settings.heading | escape
  assign fallback_product = collections.all.products[slide_index]
  assign inset_image = block.settings.inset_image | default: fallback_product.featured_image
  assign is_split = false
  if block.settings.layout == 'split'
    assign is_split = true
  endif
  assign image_two = block.settings.image_2
  if is_split and image_two == blank
    assign image_two = fallback_product.media[1].preview_image
  endif
  assign image_two_alt = image_two.alt | escape
  assign has_link = false
  if block.settings.link_label != blank and block.settings.link != blank
    assign has_link = true
  endif
  assign has_link_2 = false
  if block.settings.link_label_2 != blank and block.settings.link_2 != blank
    assign has_link_2 = true
  endif
  assign ph_second = slide_number | plus: 2
-%}

<div
  class="slide{% if block.settings.show_inset %} slide--inset{% endif %}{% if is_split %} slide--split{% endif %}{% if is_first %} is-active is-first-load{% endif %}"
  data-slide
  role="group"
  aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
  aria-label="{{ 'sections.slideshow.slide_of' | t: number: slide_number, total: section.blocks.size }}"
  {{ block.shopify_attributes }}
>
  <div class="slide__media{% if is_split %} slide__media--split{% endif %}">
    {%- if is_split -%}
      <div class="slide__half">
        {%- if block.settings.image -%}
          {{
            block.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '600, 900, 1200, 1400',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: image_loading,
              fetchpriority: image_priority,
              alt: image_alt,
              class: 'slide__image'
          }}
        {%- else -%}
          {% render 'media-placeholder', kind: 'lifestyle', index: slide_number %}
        {%- endif -%}
      </div>
      <div class="slide__half">
        {%- if image_two != blank -%}
          {{
            image_two
            | image_url: width: 1400
            | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 50vw, 100vw', loading: image_loading, alt: image_two_alt, class: 'slide__image'
          }}
        {%- else -%}
          {% render 'media-placeholder', kind: 'lifestyle', index: ph_second %}
        {%- endif -%}
      </div>
    {%- elsif block.settings.image -%}
      <picture>
        {%- if block.settings.image_mobile -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w"
          >
        {%- endif -%}
        {{
          block.settings.image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1920, 2400',
            sizes: '100vw',
            loading: image_loading,
            fetchpriority: image_priority,
            alt: image_alt,
            class: 'slide__image'
        }}
      </picture>
    {%- else -%}
      {% render 'media-placeholder', kind: 'hero', index: slide_number %}
    {%- endif -%}
  </div>
  <div class="slide__overlay" aria-hidden="true"></div>

  <div class="slide__inner page-width">
    {%- if block.settings.show_inset -%}
      <div class="slide__inset-wrap">
        <div class="slide__inset">
          {%- if block.settings.inset_video != blank -%}
            {{
              block.settings.inset_video
              | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata'
            }}
          {%- elsif inset_image != blank -%}
            {{
              inset_image
              | image_url: width: 800
              | image_tag: widths: '300, 500, 800', sizes: '(min-width: 990px) 22vw, 46vw', loading: image_loading, alt: ''
            }}
          {%- else -%}
            {% render 'media-placeholder', kind: 'product', index: slide_number %}
          {%- endif -%}
        </div>
        {%- if has_link -%}
          <a class="slide__link" href="{{ block.settings.link }}">
            {{- block.settings.link_label | escape }}
            {% render 'icon', icon: 'arrow-up-right' %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="slide__content">
      {%- if section.settings.content_style == 'framed' -%}
        <span class="slide__frame" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      {%- endif -%}
      {%- if block.settings.eyebrow != blank -%}
        <span class="slide__eyebrow eyebrow">{{ block.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if block.settings.heading != blank -%}
        <h2 class="slide__heading h0">{{ block.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if block.settings.text != blank -%}
        <p class="slide__text">{{ block.settings.text | escape }}</p>
      {%- endif -%}
      {%- liquid
        assign show_first_button = false
        if has_link and block.settings.show_inset == false
          assign show_first_button = true
        endif
      -%}
      {%- if show_first_button or has_link_2 -%}
        <div class="slide__buttons">
          {%- if show_first_button -%}
            <a class="button {{ block.settings.button_style }}" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
          {%- endif -%}
          {%- if has_link_2 -%}
            <a class="button {{ block.settings.button_style_2 }}" href="{{ block.settings.link_2 }}">{{ block.settings.link_label_2 | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Slide",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "full", "label": "One photo" },
        { "value": "split", "label": "Two photos side by side" }
      ],
      "default": "full"
    },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Wide photo, at least 1920 pixels across. With two photos, use portrait photos." },
    { "type": "image_picker", "id": "image_2", "label": "Second image", "info": "Shown beside the first one. Defaults to a product photo.", "visible_if": "{{ block.settings.layout == 'split' }}" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image on mobile", "info": "Optional tall photo for phones", "visible_if": "{{ block.settings.layout == 'full' }}" },
    { "type": "header", "content": "Framed inset" },
    { "type": "checkbox", "id": "show_inset", "label": "Show framed inset", "default": false },
    { "type": "video", "id": "inset_video", "label": "Inset video", "info": "Plays muted on a loop" },
    { "type": "image_picker", "id": "inset_image", "label": "Inset image", "info": "Defaults to a product photo" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The new collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to be carried" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Bags for every day and every evening." },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "View collection" },
    { "type": "url", "id": "link", "label": "Button link", "default": "/collections/all" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "button--light", "label": "Solid" },
        { "value": "button--ink", "label": "Dark" },
        { "value": "button--secondary", "label": "Outline" }
      ],
      "default": "button--light"
    },
    { "type": "text", "id": "link_label_2", "label": "Second button label" },
    { "type": "url", "id": "link_2", "label": "Second button link" },
    {
      "type": "select",
      "id": "button_style_2",
      "label": "Second button style",
      "options": [
        { "value": "button--light", "label": "Solid" },
        { "value": "button--ink", "label": "Dark" },
        { "value": "button--secondary", "label": "Outline" }
      ],
      "default": "button--ink"
    }
  ],
  "presets": [{ "name": "Slide" }]
}
{% endschema %}
