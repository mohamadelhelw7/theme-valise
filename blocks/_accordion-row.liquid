        },
        {
          "value": "ruler",
          "label": "Size guide"
        },
        {
          "value": "sun",
          "label": "Sun"
        },
        {
          "value": "shield",
          "label": "Shield"
        },
        {
          "value": "truck",
          "label": "Delivery"
        },
        {
          "value": "return",
          "label": "Return"
        },
        {
