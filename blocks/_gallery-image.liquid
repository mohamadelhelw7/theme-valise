{% doc %}
  Renders one photo in the social gallery. Falls back to a product photo.
{% enddoc %}

{%- liquid
  assign photo_index = 0
  for b in section.blocks
    if b.id == block.id
      assign photo_index = forloop.index0
      break
    endif
  endfor
  assign fallback_product = collections.all.products[photo_index]
  assign photo = block.settings.image | default: fallback_product.featured_image
  assign photo_link = block.settings.link | default: section.settings.link
-%}

<li class="social-gallery__item" {{ block.shopify_attributes }}>
  {%- if photo != blank -%}
    {{
      photo
      | image_url: width: 600
      | image_tag: widths: '300, 450, 600', sizes: '(min-width: 990px) 20vw, 45vw', loading: 'lazy', alt: ''
    }}
  {%- else -%}
    {%- assign ph_n = photo_index | plus: 1 -%}{% render 'media-placeholder', kind: 'product', index: ph_n %}
  {%- endif -%}
  {%- if photo_link != blank -%}
    <a class="social-gallery__link" href="{{ photo_link }}" target="_blank" rel="noopener" aria-label="{{ 'sections.social_gallery.open' | t }}">
      {% render 'icon', icon: 'instagram' %}
    </a>
  {%- endif -%}
</li>

{% schema %}
{
  "name": "Photo",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to a product photo" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the section link" }
  ],
  "presets": [{ "name": "Photo" }]
}
{% endschema %}
