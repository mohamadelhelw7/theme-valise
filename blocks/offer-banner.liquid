{% doc %}
  Offer banner: a small banner on the product page for a real offer, such as a gift with
  orders over an amount, a bundle price or free shipping. An image or an icon sits beside
  a heading and a line of text, in a dashed, filled or outlined frame.

  @example
  {% content_for 'block', type: 'offer-banner', id: 'offer-banner' %}
{% enddoc %}

{%- liquid
  assign offer = block.settings
  assign offer_has_link = false
  if offer.link != blank
    assign offer_has_link = true
  endif
-%}

<div
  class="offer-banner offer-banner--{{ offer.style }}{% if offer.accent %} offer-banner--accent{% endif %}{% if offer_has_link %} offer-banner--linked{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if offer.image != blank -%}
    <div class="offer-banner__media">
      {%- assign offer_alt = offer.image.alt | default: offer.heading -%}
      {{ offer.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '80px', alt: offer_alt }}
    </div>
  {%- elsif offer.icon != 'none' -%}
    <span class="offer-banner__icon" aria-hidden="true">{% render 'icon', icon: offer.icon %}</span>
  {%- endif -%}
  <div class="offer-banner__text">
    {%- if offer.heading != blank -%}
      <p class="offer-banner__heading">{{ offer.heading | escape }}</p>
    {%- endif -%}
    {%- if offer.text != blank -%}
      <div class="offer-banner__body">{{ offer.text }}</div>
    {%- endif -%}
    {%- if offer_has_link and offer.link_label != blank -%}
      <span class="offer-banner__cta">{{ offer.link_label | escape }}</span>
    {%- endif -%}
  </div>
  {%- if offer_has_link -%}
    <a href="{{ offer.link }}" class="offer-banner__cover">
      <span class="visually-hidden">{{ offer.link_label | default: offer.heading | escape }}</span>
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .offer-banner {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    color: var(--color-text);
  }
  .offer-banner--dashed {
    border: 2px dashed color-mix(in srgb, currentColor 55%, transparent);
  }
  .offer-banner--filled {
    background: var(--color-surface);
  }
  .offer-banner--outline {
    border: 1px solid var(--color-text);
  }
  .offer-banner--accent {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .offer-banner--accent.offer-banner--outline {
    border-color: currentColor;
  }
  .offer-banner:not(:has(.offer-banner__media, .offer-banner__icon)) {
    grid-template-columns: minmax(0, 1fr);
  }
  .offer-banner__media {
    width: 64px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }
  .offer-banner__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .offer-banner__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: color-mix(in srgb, currentColor 10%, transparent);
  }
  .offer-banner__icon .icon {
    width: 22px;
    height: 22px;
  }
  .offer-banner__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .offer-banner__heading {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .offer-banner__body {
    font-size: 0.8125rem;
    line-height: 1.45;
    opacity: 0.85;
  }
  .offer-banner__body p {
    margin: 0;
  }
  .offer-banner__cta {
    margin-top: 2px;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .offer-banner__cover {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .offer-banner__cover:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  .offer-banner--linked {
    transition: transform 0.2s ease;
  }
  @media (hover: hover) {
    .offer-banner--linked:hover {
      transform: translateY(-1px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .offer-banner--linked:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Offer banner",
  "settings": [
    {
      "type": "paragraph",
      "content": "Use it only for a real offer. Set up the discount or gift in Discounts first."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Write your offer here" },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "For example a gift with orders over an amount, or a bundle price."
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon when there is no image",
      "options": [
        { "value": "gift", "label": "Gift" },
        { "value": "truck", "label": "Truck" },
        { "value": "sparkle", "label": "Sparkle" },
        { "value": "clock", "label": "Clock" },
        { "value": "box", "label": "Box" },
        { "value": "none", "label": "None" }
      ],
      "default": "gift"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Frame",
      "options": [
        { "value": "dashed", "label": "Dashed line" },
        { "value": "filled", "label": "Filled" },
        { "value": "outline", "label": "Thin line" }
      ],
      "default": "dashed"
    },
    { "type": "checkbox", "id": "accent", "label": "Use the accent color", "default": true },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label" }
  ],
  "presets": [
    { "name": "Offer banner", "category": "Upsells" }
  ]
}
{% endschema %}
