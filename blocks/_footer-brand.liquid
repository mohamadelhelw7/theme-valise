{% doc %}
  Renders a wide brand column in the footer: logo or wordmark, a short line of text and up to three photos.

  @example
  {% content_for 'block', type: '_footer-brand', id: 'brand' %}
{% enddoc %}

<div class="footer-brand" {{ block.shopify_attributes }}>
  <a class="footer-brand__logo" href="{{ routes.root_url }}">
    {%- if block.settings.logo != blank -%}
      {{
        block.settings.logo
        | image_url: width: 500
        | image_tag: widths: '250, 500', sizes: '250px', loading: 'lazy', alt: shop.name, class: 'footer-brand__logo-image'
      }}
    {%- else -%}
      <span class="footer-brand__wordmark">{{ block.settings.wordmark | default: shop.name | escape }}</span>
    {%- endif -%}
  </a>
  {%- if block.settings.text != blank -%}
    <div class="footer-brand__text rte">{{ block.settings.text }}</div>
  {%- endif -%}
  {%- if block.settings.image_1 != blank or block.settings.image_2 != blank or block.settings.image_3 != blank -%}
    <ul class="footer-brand__photos" role="list">
      {%- for key in (1..3) -%}
        {%- assign image_key = 'image_' | append: key -%}
        {%- assign photo = block.settings[image_key] -%}
        {%- if photo != blank -%}
          <li>
            {{ photo | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '140px', loading: 'lazy', alt: '' }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .footer-brand {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .footer-brand__logo {
    color: inherit;
    text-decoration: none;
    width: fit-content;
  }
  .footer-brand__logo:hover {
    color: inherit;
  }
  .footer-brand__logo-image {
    width: 160px;
    height: auto;
  }
  .footer-brand__wordmark {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 500;
  }
  [dir='rtl'] .footer-brand__wordmark {
    letter-spacing: 0;
  }
  .footer-brand__text {
    max-width: 380px;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .footer-brand__photos {
    display: flex;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-brand__photos li {
    width: 120px;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .footer-brand__photos img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 749px) {
    .footer-brand__photos li {
      width: 30%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Use a light version on dark footers" },
    { "type": "text", "id": "wordmark", "label": "Text logo", "info": "Used when there is no logo. Defaults to your store name." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Bags for every day and every evening, made to be carried for years.</p>" },
    { "type": "image_picker", "id": "image_1", "label": "Photo 1" },
    { "type": "image_picker", "id": "image_2", "label": "Photo 2" },
    { "type": "image_picker", "id": "image_3", "label": "Photo 3" }
  ],
  "presets": [{ "name": "Brand" }]
}
{% endschema %}
