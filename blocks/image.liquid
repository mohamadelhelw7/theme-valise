{% doc %}
  Renders a rounded image with optional link.

  @example
  {% content_for 'block', type: 'image', id: 'image' %}
{% enddoc %}

{%- liquid
  if block.settings.link != blank
    assign wrapper = 'a'
  else
    assign wrapper = 'div'
  endif
-%}

<{{ wrapper }}
  class="image-block media-tile"
  style="--image-ratio: {{ block.settings.ratio }}; --tile-bg: var(--tint-1);"
  {% if block.settings.link != blank %}
    href="{{ block.settings.link }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.image -%}
    {{
      block.settings.image
      | image_url: width: 1600
      | image_tag:
        loading: 'lazy',
        widths: '400, 800, 1200, 1600',
        sizes: '(min-width: 750px) 50vw, 100vw'
    }}
  {%- else -%}
    {% render 'media-placeholder', kind: 'lifestyle' %}
  {%- endif -%}
</{{ wrapper }}>

{% stylesheet %}
  .image-block {
    display: block;
    width: 100%;
    aspect-ratio: var(--image-ratio);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 2", "label": "Landscape" },
        { "value": "16 / 9", "label": "Wide" }
      ],
      "default": "4 / 5"
    }
  ],
  "presets": [{ "name": "Image", "category": "Media" }]
}
{% endschema %}
