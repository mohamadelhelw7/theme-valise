{% doc %}
  Renders one trust/feature item with an icon, title and caption.

  @example
  {% content_for 'block', type: '_feature', id: 'feature' %}
{% enddoc %}

<div class="feature" {{ block.shopify_attributes }}>
  {%- if block.settings.custom_icon -%}
    {{ block.settings.custom_icon | image_url: width: 80 | image_tag: class: 'feature__img', alt: '', loading: 'lazy' }}
  {%- else -%}
    <span class="feature__icon">{% render 'icon', icon: block.settings.icon %}</span>
  {%- endif -%}
  <div>
    <div class="feature__title">{{ block.settings.title | escape }}</div>
    {%- if block.settings.text != blank -%}
      <div class="feature__text">{{ block.settings.text | escape }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .feature {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 20px;
    background: var(--color-surface);
    border-radius: 18px;
  }
  .feature__icon {
    color: var(--color-accent);
  }
  .feature__icon .icon,
  .feature__img {
    width: 28px;
    height: 28px;
  }
  .feature__title {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .feature__text {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
{% endstylesheet %}

