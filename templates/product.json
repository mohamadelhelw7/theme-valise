{
  "sections": {
    "main": {
      "type": "main-product-room",
      "blocks": {
        "title": {
          "type": "product-title",
          "settings": {
            "label": "type"
          }
        },
        "price": {
          "type": "product-price",
          "settings": {
            "show_tax_note": false,
            "show_installments": false
          }
        },
        "variant_picker": {
          "type": "variant-picker",
          "settings": {
            "style": "pills",
            "swatches": true
          }
        },
        "inventory": {
          "type": "inventory-status",
          "settings": {
            "low_threshold": 10,
            "show_count": true
          }
        },
        "personalize": {
          "type": "personalize",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy-buttons",
          "settings": {
            "show_quantity": true,
            "show_dynamic_checkout": true,
            "note_icon": "truck"
          }
        },
        "restock": {
          "type": "restock-alert",
          "settings": {
            "color_scheme": "scheme-2",
            "heading": "This one is sold out",
            "text": "Want it when it's back? Leave your email.",
            "button_label": "Notify me",
            "success": "You're on the list for this one."
          }
        },
        "save": {
          "type": "save-button",
          "settings": {
            "style": "button--secondary",
            "full_width": true
          }
        },
        "whatsapp": {
          "type": "whatsapp-button",
          "settings": {
            "label": "Ask us on WhatsApp",
            "message": "Hi! I have a question about",
            "style": "button--secondary",
            "full_width": true
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "inventory",
        "personalize",
        "buy_buttons",
        "restock",
        "save",
        "whatsapp"
      ],
      "settings": {
        "color_scheme": "scheme-4",
        "follow_color": true,
        "color_strength": 26,
        "sticky_atc": "mobile"
      }
    },
    "views": {
      "type": "gallery-views",
      "settings": {
        "scheme_a": "scheme-2",
        "scheme_b": "scheme-4",
        "show_captions": true,
        "limit": 6
      }
    },
    "about": {
      "type": "wall-text",
      "settings": {
        "color_scheme": "scheme-1",
        "source": "product",
        "label": "About this piece",
        "size": "large",
        "padding_top": "large",
        "padding_bottom": "medium"
      }
    },
    "entry": {
      "type": "catalogue-entry",
      "blocks": {
        "bag_size": {
          "type": "bag-size",
          "settings": {
            "style": "open",
            "unit": "cm",
            "show_diagram": true
          }
        },
        "details": {
          "type": "accordion",
          "settings": {
            "style": "lines",
            "single_open": true
          },
          "blocks": {
            "details_1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Materials and care",
                "icon": "bag",
                "content": "<p>List the materials, the lining and how to clean and store this bag.</p>"
              }
            },
            "details_2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Shipping and returns",
                "icon": "truck",
                "content": "<p>Add your delivery times and return policy.</p>"
              }
            }
          },
          "block_order": [
            "details_1",
            "details_2"
          ]
        },
        "delivery": {
          "type": "delivery-info",
          "settings": {
            "style": "boxed",
            "show_estimate": true,
            "min_days": 1,
            "max_days": 4,
            "cutoff_hour": 14,
            "skip_friday": true,
            "skip_saturday": false,
            "skip_sunday": false,
            "zone_layout": "selector"
          },
          "blocks": {
            "zone_cairo": {
              "type": "_delivery-zone",
              "settings": {
                "zone_name": "Cairo and Giza",
                "governorates": "Cairo, Giza"
              }
            },
            "zone_delta": {
              "type": "_delivery-zone",
              "settings": {
                "zone_name": "Alexandria and Delta",
                "governorates": "Alexandria, Qalyubia, Sharqia, Dakahlia, Gharbia, Monufia, Beheira, Kafr El Sheikh, Damietta"
              }
            },
            "zone_canal": {
              "type": "_delivery-zone",
              "settings": {
                "zone_name": "Canal cities",
                "governorates": "Port Said, Ismailia, Suez"
              }
            },
            "zone_upper": {
              "type": "_delivery-zone",
              "settings": {
                "zone_name": "Upper Egypt",
                "governorates": "Faiyum, Beni Suef, Minya, Asyut, Sohag, Qena, Luxor, Aswan"
              }
            },
            "zone_remote": {
              "type": "_delivery-zone",
              "settings": {
                "zone_name": "Remote areas",
                "governorates": "Red Sea, New Valley, Matrouh, North Sinai, South Sinai"
              }
            }
          },
          "block_order": [
            "zone_cairo",
            "zone_delta",
            "zone_canal",
            "zone_upper",
            "zone_remote"
          ]
        },
        "payments": {
          "type": "payment-icons",
          "settings": {
            "text": "Secure checkout"
          }
        }
      },
      "block_order": [
        "bag_size",
        "details",
        "delivery",
        "payments"
      ],
      "settings": {
        "color_scheme": "scheme-2",
        "label": "Catalogue entry",
        "show_vendor": true,
        "show_type": true,
        "show_sku": true,
        "padding_top": "large",
        "padding_bottom": "large"
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "color_scheme": "scheme-1",
        "heading": "You might also like",
        "intent": "related",
        "limit": 4,
        "mobile_layout": "swipe",
        "padding_top": "large",
        "padding_bottom": "none",
        "header_alignment": "center"
      }
    },
    "reviews": {
      "type": "product-reviews",
      "blocks": {
        "r1": {
          "type": "_review",
          "settings": {
            "show_image": true
          }
        },
        "r2": {
          "type": "_review",
          "settings": {
            "show_image": true
          }
        },
        "r3": {
          "type": "_review",
          "settings": {
            "show_image": true
          }
        },
        "r4": {
          "type": "_review",
          "settings": {
            "show_image": true
          }
        }
      },
      "block_order": [
        "r1",
        "r2",
        "r3",
        "r4"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "eyebrow": "Reviews",
        "heading": "What people are saying",
        "layout": "slider",
        "button_label": "Write a review",
        "anchor": "reviews",
        "padding_top": "large",
        "padding_bottom": "none"
      }
    },
    "hall": {
      "type": "gallery-hall",
      "settings": {
        "color_scheme": "scheme-1",
        "label": "In the same room",
        "auto_fill": true,
        "products_to_show": 5,
        "layout": "salon",
        "link_label": "See the whole collection",
        "padding_top": "large",
        "padding_bottom": "large"
      }
    },
    "recent": {
      "type": "recently-viewed",
      "settings": {
        "color_scheme": "scheme-1",
        "heading": "Recently viewed",
        "header_alignment": "start",
        "limit": 6,
        "columns": 4,
        "padding_top": "large",
        "padding_bottom": "large"
      }
    }
  },
  "order": [
    "main",
    "views",
    "about",
    "entry",
    "recommendations",
    "reviews",
    "hall",
    "recent"
  ]
}
